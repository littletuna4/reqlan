{
  "scan": {
    "defaultMaxDepth": 20,
    "defaultMaxEntries": 100000,
    "minDepth": 1,
    "maxDepthLimit": 100,
    "minEntries": 1,
    "maxEntriesLimit": 2500000
  },
  "click": {
    "maxSessions": 100,
    "listLimit": 8,
    "minimum": 1
  },
  "importRootAlias": "@",
  "parseBudgetMs": 8000,
  "graphHopDepth": 20,
  "paths": {
    "applicationMemoryDir": ".reqlan",
    "configFilename": "config.json",
    "rqignoreFilename": ".rqignore",
    "gitignoreFilename": ".gitignore",
    "ideasIndexFilename": "ideas-index.sqlite",
    "indexDiagnosticsFilename": "index-diagnostics.sqlite",
    "clickSessionsFilename": "click-sessions.sqlite"
  },
  "rqignore": {
    "groups": [
      {
        "title": "Dependencies",
        "patterns": [
          "node_modules/",
          "bower_components/",
          "vendor/"
        ]
      },
      {
        "title": "Python / virtualenvs",
        "patterns": [
          "venv/",
          ".venv/",
          "env/",
          ".env/",
          "__pycache__/",
          "*.pyc",
          ".pytest_cache/",
          ".mypy_cache/",
          ".tox/",
          ".ruff_cache/"
        ]
      },
      {
        "title": "Build / tooling output",
        "patterns": [
          "dist/",
          "out/",
          "build/",
          "bin/",
          "generated/",
          "coverage/",
          "target/",
          ".next/",
          ".nuxt/",
          ".turbo/",
          ".cache/",
          "*.tsbuildinfo",
          "*.html"
        ]
      },
      {
        "title": "VCS / editor / package stores",
        "patterns": [
          ".git/",
          ".svn/",
          ".hg/",
          ".cursor/",
          ".pnpm-store/",
          ".vscode/",
          ".idea/"
        ]
      },
      {
        "title": "Hidden paths - skip dotfiles; include one with !path",
        "patterns": [
          ".*",
          ".*/"
        ]
      },
      {
        "title": "Application memory - do not crawl this folder for .rq sources",
        "patterns": [
          ".reqlan/"
        ]
      },
      {
        "title": "Databases and SQLite sidecars",
        "patterns": [
          "*.db3",
          "*.sqlite",
          "*.sqlite3",
          "*.db",
          "*.sqlite-wal",
          "*.sqlite-shm",
          "*.sqlite-journal",
          "*.sqlite3-wal",
          "*.sqlite3-shm",
          "*.sqlite3-journal",
          "*.db-wal",
          "*.db-shm",
          "*.db-journal",
          "*.db3-wal",
          "*.db3-shm",
          "*.db3-journal"
        ]
      },
      {
        "title": "Files without comments",
        "patterns": [
          "*.json",
          "*.jsonl",
          "*.ndjson",
          "*.geojson",
          "*.topojson",
          "*.har",
          "*.sarif",
          "*.webmanifest",
          "*.ipynb",
          "*.gltf",
          "*.csv",
          "*.tsv",
          "*.tab",
          "pnpm-lock.yaml",
          "bun.lockb",
          "Package.resolved",
          "*.lock",
          "*.sum",
          "*.sha1",
          "*.sha256",
          "*.sha512",
          "*.md5",
          "*.snap",
          "*.min.js",
          "*.min.mjs",
          "*.min.cjs",
          "*.min.css",
          "*.js.map",
          "*.mjs.map",
          "*.cjs.map",
          "*.css.map",
          "*.map",
          "*.pem",
          "*.crt",
          "*.cer",
          "*.der",
          "*.p12",
          "*.pfx",
          "*.p7b",
          "*.key",
          "*.mo"
        ]
      },
      {
        "title": "Secrets / logs / temp",
        "patterns": [
          "*.secret.rq",
          "*.log",
          "tmp/",
          "temp/"
        ]
      }
    ],
    "binaryTitle": "# Binary files - skipped unless you opt in with !*.ext (example: !*.bin)",
    "binary": [
      "*.bin",
      "*.exe",
      "*.dll",
      "*.so",
      "*.dylib",
      "*.o",
      "*.obj",
      "*.a",
      "*.lib",
      "*.class",
      "*.wasm",
      "*.node",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.webp",
      "*.ico",
      "*.bmp",
      "*.tif",
      "*.tiff",
      "*.heic",
      "*.avif",
      "*.mp4",
      "*.webm",
      "*.mov",
      "*.avi",
      "*.mkv",
      "*.mp3",
      "*.wav",
      "*.ogg",
      "*.flac",
      "*.aac",
      "*.m4a",
      "*.zip",
      "*.tar",
      "*.gz",
      "*.tgz",
      "*.bz2",
      "*.xz",
      "*.7z",
      "*.rar",
      "*.pdf",
      "*.doc",
      "*.docx",
      "*.xls",
      "*.xlsx",
      "*.ppt",
      "*.pptx",
      "*.ttf",
      "*.otf",
      "*.woff",
      "*.woff2",
      "*.eot",
      "*.dmg",
      "*.iso",
      "*.img",
      "*.apk",
      "*.jxl",
      "*.jfif",
      "*.jp2",
      "*.psd",
      "*.ai",
      "*.exr",
      "*.hdr",
      "*.tga",
      "*.dds",
      "*.ktx",
      "*.ktx2",
      "*.icns",
      "*.cur",
      "*.glb",
      "*.fbx",
      "*.stl",
      "*.blend",
      "*.wma",
      "*.aiff",
      "*.aif",
      "*.mid",
      "*.midi",
      "*.wmv",
      "*.flv",
      "*.m4v",
      "*.zst",
      "*.lz4",
      "*.lzma",
      "*.cab",
      "*.jar",
      "*.war",
      "*.ear",
      "*.whl",
      "*.nupkg",
      "*.vsix",
      "*.deb",
      "*.rpm",
      "*.msi",
      "*.pdb",
      "*.ilk",
      "*.exp",
      "*.pyo",
      "*.pyd",
      "*.rlib",
      "*.ttc",
      "*.npy",
      "*.npz",
      "*.h5",
      "*.hdf5",
      "*.pkl",
      "*.pickle",
      "*.onnx",
      "*.pb",
      "*.svg",
      "*.svgz",
      "*.heif"
    ],
    "seedHeader": [
      "# reqlan path ignore",
      "#",
      "# Purpose",
      "# This file filters which paths discovery and indexing crawl.",
      "# The CLI, the MCP server, and the editor share this filter.",
      "#",
      "# Scope",
      "# Patterns are relative to the base root (the parent of .reqlan).",
      "# Patterns are not relative to this .reqlan folder.",
      "# This file is not Git ignore.",
      "# Git ignore for SQLite stores is .gitignore in this folder.",
      "#",
      "# Syntax",
      "# Use gitignore syntax. A trailing slash matches a directory.",
      "# The last matching rule wins.",
      "# A line that starts with ! includes a path that an earlier rule skipped.",
      "# Examples: !src/vendor/   !*.bin",
      "#",
      "# Built-in defaults",
      "# Built-in defaults always apply, even if this file is missing.",
      "# Lines in this file add to those defaults or override them.",
      "# If you delete a line here, the matching built-in rule still applies.",
      "#",
      "# Binary files",
      "# Binary globs are skipped by default.",
      "# That set includes images, archives, packages, native objects, fonts, media, and office files.",
      "# Include a type with a negation. Example: !*.bin",
      "# Opted-in files can be scanned for rq: comment references.",
      "# They are not parsed as .rq sources.",
      "#",
      "# Hidden paths",
      "# .* and .*/ skip hidden files and directories.",
      "# Include one path with a negation. Example: !.github/",
      "#",
      "# Secrets",
      "# *.secret.rq is skipped.",
      "#",
      "# Databases",
      "# The filter skips database files and SQLite sidecar files.",
      "# Sidecar suffixes are -wal, -shm, and -journal.",
      "# Example: *.sqlite-wal",
      "#",
      "# Files without comments",
      "# The filter skips common files that have no comment syntax.",
      "# This set includes JSON, CSV, lockfiles, checksums, minified files, source maps, and certificates.",
      "# These files cannot hold rq: references.",
      "# Include one type with a negation. Example: !*.json",
      "#",
      "# Application memory",
      "# .reqlan/ is not crawled for requirement sources.",
      "#",
      "# After you edit this file, the next index walk applies your rules."
    ]
  }
}
