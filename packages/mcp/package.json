{
    "name": "@reqlan/mcp",
    "description": "MCP server exposing reqlan requirement graph tools",
    "version": "0.3.9",
    "type": "module",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/littletuna4/reqlan.git"
    },
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out"
    ],
    "bin": {
        "reqlan-mcp": "./bin/mcp.js"
    },
    "main": "./out/main.js",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc -b tsconfig.json",
        "build:clean": "pnpm run clean && pnpm run build",
        "start": "node ./bin/mcp.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "@reqlan/analytical": "workspace:*",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "shx": "~0.4.0"
    }
}
