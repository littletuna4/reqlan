{
    "name": "@reqlan/cli",
    "description": "CLI for parsing, analysing, and exporting reqlan requirement graphs",
    "version": "0.2.1",
    "type": "module",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/littletuna4/reqlan.git"
    },
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out"
    ],
    "bin": {
        "reqlan": "./bin/cli.js",
        "rq": "./bin/cli.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc -b tsconfig.json",
        "build:clean": "pnpm run clean && pnpm run build"
    },
    "dependencies": {
        "clipanion": "3.2.1",
        "langium": "~4.3.0",
        "@reqlan/analytical": "workspace:*",
        "@reqlan/language": "workspace:*"
    },
    "devDependencies": {
        "shx": "~0.4.0"
    }
}
