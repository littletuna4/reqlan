# reqlan path ignore (gitignore syntax).
# Applied relative to the base root (parent of .reqlan).
# Built-in defaults always apply; use !pattern to force-include.

/packages/extension/templates/thanks-for-installing.template.rq

# Dependencies
node_modules/
bower_components/
vendor/

# Python / virtualenvs
venv/
.venv/
env/
.env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.tox/
.ruff_cache/

# Build / tooling output
dist/
out/
build/
bin/
generated/
coverage/
.next/
.nuxt/
.turbo/
.cache/
*.tsbuildinfo
*.html

# VCS / editor / package stores
.git/
.svn/
.hg/
.cursor/
.pnpm-store/
.vscode/
.idea/

# Hidden entries (preserves prior walk behaviour; un-ignore with !path)
.*
.*/

# reqlan application memory (never crawl the marker dir for .rq sources)
.reqlan/

# Databases / binary stores
*.db3
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db-wal
*.db-shm
*.db-journal
*.db3-wal
*.db3-shm
*.db3-journal

# Files without comments
*.json
*.jsonl
*.ndjson
*.geojson
*.topojson
*.har
*.sarif
*.webmanifest
*.ipynb
*.gltf
*.csv
*.tsv
*.tab
pnpm-lock.yaml
bun.lockb
Package.resolved
*.lock
*.sum
*.sha1
*.sha256
*.sha512
*.md5
