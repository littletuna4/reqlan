nested_curly_braces {
    if there is a prose block containing curly braces, {such as this one} they should be treated as part of the prose.
    Matching braces that end a line — including adjacent pairs like {{SITE_URL}} — stay in the body; they must not close the enclosing idea.
    A lone `}` on its own line still closes the structural block so an unbalanced prose `{` cannot swallow the idea closer.

    @tests (
        ["../../packages/language/test/parsing.test.ts:keeps inline prose brace pairs as text"]
        ["../../packages/language/test/parsing.test.ts:keeps end-of-line matching prose braces as text"]
        ["../../packages/language/test/parsing.test.ts:parse thanks-for-installing template"]
        ["../../crates/reqlan-parse/tests/parser.rs:keeps_inline_prose_braces"]
        ["../../crates/reqlan-parse/tests/parser.rs:keeps_end_of_line_matching_prose_braces"]
        ["../../crates/reqlan-parse/tests/lexer.rs:prose_braces_stay_other"]
    )
    @implementation (
        ["../../packages/language/src/reqlan-token-builder.ts"]
    )
}

context_sensitive_lexer_scaling {
    Context-sensitive token classification for structural/prose braces and top-level import keywords must remain linear in document size.
    The lexer records brace-depth changes sparsely (not per-character tables) and looks them up in log time while tokenising, so workspace language-server initialization and editor re-lexes stay bounded.
    Code fences are skipped during the brace scan so example braces cannot inflate work or desync depth.
    Bounded work still assumes the lexer/parser *returns*; unbounded hangs are cut by ["./parser_lexer.rq".parse_budget_timeout].

    @status done
    @tests (
        ["../../packages/language/test/parsing.test.ts:parses a large import prelude without repeated full-document brace scans"]
        ["../../packages/language/test/parsing.test.ts:treats fenced TypeScript braces as opaque for surrounding structure"]
    )
    @implementation (
        ["../../packages/language/src/reqlan-token-builder.ts"]
    )
}

fencing_comments {
    A complete same-line fence keeps `//` and `/*` as prose, not comments.
    Closed double quotes: "//this line" contains no comment.
    Closed backticks: `//this line` contains no comment.
    Closed backticks with a glob: `@reqlan/*` does not open a block comment.
    An unclosed backtick is not a fence, so this line `// finishes with a comment.
    An unclosed quote is not a fence, so as does "//this one
    The Langium lexer, the Rust lexer, comment scanners, and TextMate must use this rule.
    Related: ["./syntax.rq".comments], ["./syntax.rq".inline_code], ["./syntax.rq".naked_strings_in_body], ["../core_analysis/rust_port.rq".comment_span_align].
    @status done
    @implementation (
        ["../../packages/language/src/reqlan-line-fences.ts"]
        ["../../packages/language/src/reqlan-token-builder.ts"]
        ["../../packages/language/src/reqlan-comment-resolver.ts"]
        ["../../packages/language/scripts/patch-textmate.mjs"]
        ["../../packages/language/syntaxes/reqlan.tmLanguage.json"]
        ["../../crates/reqlan-parse/src/lexer.rs"]
        ["../../crates/reqlan-index/src/rq_ignore.rs"]
    )
    @tests (
        ["../../packages/language/test/parsing.test.ts:parse syntax-edge-cases.rq"]
        ["../../packages/language/test/comment-in-string.test.ts:isInsideLineFence treats only complete same-line fences as fences"]
        ["../../packages/language/test/comment-in-string.test.ts:quoted //this line in block body is not a line comment"]
        ["../../packages/language/test/comment-in-string.test.ts:backticked //this line in block body is not a line comment"]
        ["../../packages/language/test/comment-in-string.test.ts:unclosed backtick then // is a line comment"]
        ["../../packages/language/test/comment-in-string.test.ts:unclosed quote then // is a line comment"]
        ["../../packages/language/test/references.test.ts:ignores // inside complete backtick fences when locating line comments"]
        ["../../packages/language/test/references.test.ts:findCommentSpansInText treats unclosed fences as comments and closed fences as prose"]
        ["../../packages/language/test/references.test.ts:findCommentSpansInText skips /* inside complete backtick fences"]
        ["../../packages/language/test/comment-in-string.test.ts:backticked @reqlan/* in block body is not a block comment"]
        ["../../packages/language/test/comment-span-align.test.ts:backticked @reqlan/* is not a block comment"]
        ["../../packages/language/test/langium-rust-parse-align.test.ts:fencing_comments"]
        ["../../crates/reqlan-parse/tests/lexer.rs:backticked_slash_star_is_not_a_comment"]
        ["../../crates/reqlan-parse/tests/lexer.rs:quoted_slash_slash_in_body_is_not_a_comment"]
        ["../../crates/reqlan-parse/tests/lexer.rs:backticked_slash_slash_in_body_is_not_a_comment"]
        ["../../crates/reqlan-parse/tests/lexer.rs:unclosed_backtick_then_slash_slash_is_a_comment"]
        ["../../crates/reqlan-parse/tests/lexer.rs:unclosed_quote_then_slash_slash_is_a_comment"]
        ["../../crates/reqlan-index/src/rq_ignore.rs:does_not_treat_marker_inside_backticks_as_a_directive"]
    )
}

