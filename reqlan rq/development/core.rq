import "../phonebook.rq" as phonebook_reqs
import "../../scripts/phonebook.ts" as phonebook_script

scope these requirements describe the actual development of the reqlan language and tooling itself

modulurisation files should be small

succinct maximised meaning to character ratio.

hierarchy_of_requirements user request trumps the ["../../reqlan rq"] requirements, and ["../../reqlan rq"] trump the current implementation.

stack {
    - Requirements are documented with reqlan in the ["../../reqlan rq"] folder.
    - Language grammar truth is ["../../reqlan rq/language/syntax.rq"]; the default editor LSP is Rust (`reqlan-lsp`).
    - Langium in `@reqlan/language` remains a dual-parser oracle and the transitional `node` engine fallback.
    - VS Code extension host is in ["../../packages/extension"]; open-buffer features run in `crates/reqlan-lsp`.
    - vscode webviews are implemented with svelte
    - Extension build pipeline is documented in ["./build.rq"]
}

napi_module_barrel {
    per [stack]
    `crates/reqlan-napi/src/lib.rs` is a barrel: it only declares modules and re-exports the napi items. Logic lives in one module per binding surface.
    Modules: `scan.rs` (scanWorkspace task, createBase), `analysis.rs` (NativeAnalysisRuntime), `sql_db.rs` (NativeSqlDb), `workspace_index.rs` (NativeWorkspaceIndex), `source.rs` (parse/extract/local-symbolic source helpers), `planner.rs` (barrel/move/delete plan), `util.rs` (shared error mappers, wire-JSON helpers).
    Invariants: the JS surface and generated napi `.d.ts` do not change; modules stay flat in `src/` so `rq:[...]` comment paths keep `../../../reqlan rq` depth; `rq:` doc comments move with their items; `@implementation` refs in ["../../reqlan rq"] point at the module that holds the item, not the barrel.
    New analysis bindings must follow ["../core_analysis/rope.rq".rope]: engine item in `reqlan-analytical`, `analysis.rs` binding, AnalysisApi facade, and cross-referenced tests.
    @status done
    @implementation (
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../crates/reqlan-napi/src/analysis.rs"]
        ["../../crates/reqlan-napi/src/planner.rs"]
        ["../../crates/reqlan-napi/src/scan.rs"]
        ["../../crates/reqlan-napi/src/source.rs"]
        ["../../crates/reqlan-napi/src/sql_db.rs"]
        ["../../crates/reqlan-napi/src/util.rs"]
        ["../../crates/reqlan-napi/src/workspace_index.rs"]
    )
    @tests (
        ["../../packages/analytical/test/load-native.test.ts"]
        ["../../packages/analytical/test/open-analysis-api.test.ts"]
    )
}

pnpm {
    Must use pnpm for all js package management across the monorepo (packages, extension, site).
}

pnpm_val {
    Root `pnpm run val` chains `check`, then `test`, then `build` (["../../package.json"]).
    Use for local / ingestion validation (["../ingest/ingest.rq"._file]).
    @status done
}

iconify_stack {
    Icons use Iconify offline — bundled at build time, not fetched from a CDN at runtime.
    Icon data comes from npm packages listed under the `icons` key in ["../phonebook.json"] per [phonebook_reqs.phonebook_icons].
}

phonebook_icon_keys {
    per [phonebook_reqs.phonebook_icons]
    A phonebook link or package can omit `icon`. If `icon` is present, it is an object with `set` and `name`.
    Set ids and lookup URLs are canonical in ["../phonebook.json"].icons.
    Use each set's `search` URL to find replacement slugs when a name changes or an icon is removed upstream.
    Typed helpers live in [phonebook_script]: `formatPhonebookIconKey`, `getPhonebookIconSearchUrl`.
    @status done
    @tests (
        ["../../site/src/lib/phonebook-icons.test.ts"]
    )
}

current_link_icons {
    Slugs are defined on each link in ["../phonebook.json"]:
    - `site` → mdi / web
    - `vsc` → simple-icons / visualstudiocode
    - `openvsx` → simple-icons / vscodium (proxy; no Open VSX slug in Simple Icons)
    - `github` → simple-icons / github
    - `discord` → simple-icons / discord
    - `github-sponsors` → simple-icons / githubsponsors
    - `email` → mdi / email-outline
    - `sticker-form` → mdi / sticker-emoji
    Package entries under `packages` all use simple-icons / npm:
    - `language`, `analytical`, `cli`
}

rust_mindset {
    - code should be complete
    - nulls should be safe and deliberate
    - fallbacks should be used sparingly
    - incomplete code should be marked as such
    - comments should describe final desired state of the code, not the current state; they should be timeless.
    - tests should be local
}

code_comment_references {
    code comments should include reference to their respective rq references.
}

testing {
    tests should have comment references to the requirements they serve to test. per ["../extension/language/comment-references/functional-code-comment-references.rq"]
    @tests: (
        ["../../packages/language/test/testing.test.ts:each test file includes rq comment references to its requirements"]
    )
}