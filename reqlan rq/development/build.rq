import "./core.rq" as development_core
import "../distribution/distribution.rq" as distribution
import "../../packages/extension/scripts/build.mjs" as extension_build_script
import "../../packages/extension/scripts/generate-readme.ts" as extension_readme_script
import "../../packages/extension/esbuild.mjs" as extension_esbuild
import "../../packages/extension/webviews/ideas-summary/vite.config.ts" as ideas_summary_vite_config
import "../../packages/extension/webviews/activity-bar/vite.config.ts" as activity_bar_vite_config
import "../../packages/extension/webviews/onboarding/vite.config.ts" as onboarding_vite_config

scope extension build steps for local development and CI

extension_build {
    Production builds for the VS Code extension are orchestrated by [extension_build_script].
    Run from the extension package: `pnpm run build` or `node scripts/build.mjs`.
    Workspace-wide builds also run langium generation and sibling packages via the root `pnpm run build`.
    Local and F5 builds use [incremental_extension_build]; VSIX prepublish uses the forced path.
}

incremental_extension_build {
    Extension builds fingerprint inputs and outputs per independently cacheable artifact:
    - Langium generated sources / TextMate grammar
    - generated shared graph-physics source
    - logo media
    - generated marketplace README
    - each of the five Vite webviews separately
    - extension-host / language-server esbuild outputs
    Host napi staging ([extension_host_native_stage]) always runs: cargo is incremental, and CI/Azure skip the compile.
    A step is skipped only when its command/input fingerprint and current output-content fingerprint both match the cache under `packages/extension/out/`.
    Missing, changed, or manually edited output invalidates that step.
    Webview output fingerprints cover each complete emitted directory, including future lazy chunks. Host-bundle inputs include bundled phonebook data as well as workspace package output.
    TypeScript retains its native `tsc -b` project-reference incrementality.
    TextMate syntax copies are cached by content; Cursor-skill sync still runs because it targets workspace-external state.
    `pnpm run build:force` / `node scripts/build.mjs --force` bypasses all cache entries; `vscode:prepublish` uses this forced mode for release correctness.
    `clean` removes `out/`, including the cache, so clean builds remain cold.
    Root `pnpm run build:ext` delegates only to the extension package. The extension build generates Langium/physics artifacts when their fingerprints change, then its `tsc -b` builds language/analytical project references before downstream fingerprints are evaluated. It does not rebuild unrelated CLI, MCP, site, or test projects.
    @tests (
        ["../../packages/extension/test/incremental-build.test.ts"]
        ["../../packages/analytical/test/native-packaging.test.ts"]
    )
    @status done
}

extension_host_native_stage {
    Local F5 and `pnpm run build` / `build:ext` stage the host-matching core engine `.node` into `packages/extension/native/` so activation loads the same layout as a per-target VSIX ([distribution.vsix_export], [distribution.extension_host_target]).
    The orchestrator builds `cargo build -p reqlan-napi --release` when needed, then copies `reqlan_napi.node` beside the extension; it is not a separate manual install.
    CI / Azure skip the cargo compile (`CI` or `TF_BUILD`) and fetch published platform packages later ([distribution.extension_distribution]).
    Implementation: ["../../scripts/stage-host-native.mjs"], ["../../packages/extension/scripts/build.mjs"].
    @status done
    @tests (["../../packages/analytical/test/native-packaging.test.ts"])
}

extension_media_build {
    Extension logo assets are generated by ["../../packages/extension/scripts/generate-media.mjs"] from ["../../site/public/logo.svg"].
    PNG (`media/logo.png`) is tracked in git and used as the packaged icon for marketplace, language file icon, and activity bar (Azure Marketplace rejects SVG).
    WebP and SVG copies remain build outputs (gitignored); regenerate via `build:media` when the source logo changes.
    Invoked as `pnpm run build:media` at the start of [extension_build_script].
}

extension_readme_build {
    Generate `packages/extension/README.md` from [extension_readme_script] and README.template.md before VSIX packaging.
    Marketplace links are resolved from ["../../scripts/phonebook.ts"]; changelog body comes from packages/extension/CHANGELOG.md (Changesets output).
    Invoked as `pnpm run build:readme` at the start of [extension_build_script].
    Requirement: ["../distribution/distribution.rq".extension_readme].
}

build_prepare {
    Copy TextMate grammars from the language package into extension syntaxes.
    Sync Cursor agent skills from extension sources into `.cursor/skills`.
    The orchestrator caches `build:syntaxes` independently and always runs the external Cursor-skill sync before webview and host bundling.
}

webview_build {
    Svelte webview UI is bundled with Vite per [development_core].
    Configs: [ideas_summary_vite_config], [activity_bar_vite_config], [onboarding_vite_config]
    @steps (
        npx vite build --config webviews/ideas-summary/vite.config.ts
        npx vite build --config webviews/activity-bar/vite.config.ts
        npx vite build --config webviews/onboarding/vite.config.ts
    )
    Output lands in `packages/extension/media/webviews/` for the extension host to load.
    The onboarding webview inlines ["../../packages/extension/templates/thanks-for-installing.template.rq"] via Vite `?raw` for the in-page language example; the template source stays excluded from the VSIX.
    Requirement: ["../extension/onboarding/page-thanks-for-installing.rq".installation_event].
    Watch mode during development: `bash scripts/watch.sh` vite `--watch` alongside tsc and esbuild.
}

typescript_emit {
    Package TypeScript emit goes to each package `out/` via `tsc -b` project references (["../../tsconfig.build.json"]).
    Shared compiler options live in ["../../tsconfig.base.json"]. ["../../tsconfig.json"] is a solution file (`files: []`) so a plain `tsc` / VS Code "tsc: build" does not write `.js`, `.d.ts`, or `.js.map` next to sources.
    Webview tsconfigs are `noEmit` — Vite bundles to `packages/extension/media/webviews/`.
    @status done
}

extension_typecheck {
    Extension TypeScript sources are checked with `tsc -b tsconfig.json` before bundling.
    `noEmit: true` — compilation output comes from esbuild, not tsc.
}

extension_bundle {
    The extension host (`src/extension/main.ts`) and language server (`src/language/main.ts`) are bundled with esbuild per [extension_esbuild].
    The host-matching core engine `.node` is staged under `native/` by [extension_host_native_stage] for F5 and for per-target VSIX packaging; it is not inlined into `main.cjs`.
    @steps (
        node esbuild.mjs
    )
    Output: CommonJS `.cjs` files under `packages/extension/out/`.
    `vscode` remains external; a small `Object.groupBy` polyfill is injected for older Node runtimes.
}
