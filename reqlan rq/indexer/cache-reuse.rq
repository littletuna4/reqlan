index_cache_reuse {
    Identify where the ideas index, diagnostics store, or in-process caches already hold
    data that other modules recompute.
    Goal: one walk, one sync, one open store where possible; reuse SQLite edges and mtime
    maps instead of rebuilding graphs from scratch.
    Related: [nonblocking_index], [indexing_incrementality], [consumers.index_consumers],
    [sequencing.index_sequencing].

    @status draft
}

already_cached {
    Mechanisms that already reuse stored state:
    - Soft sync mtime skip on [ideas_schema.documents_table] ([nonblocking_index])
    - Code-file negative cache ([code_file_negative_cache]) so no-`rq:` sources skip on later soft syncs
    - Idle stale check that indexes only dirty paths ([indexing_trigger_auto])
    - Git date columns on [ideas_schema.ideas_table] (no git walk on every UI paint)
    - Fuzzy search and paged Ideas Summary SQL over SQLite (avoid full in-memory dumps when used)
    [index_cache_reuse]
}

code_file_negative_cache {
    Allowlisted code files with no [comment_reference] still get a [ideas_schema.documents_table]
    row (`content_hash` + `mtime_ms`, no ideas, no edges). Soft [sequencing.soft_sync] and
    [sequencing.idle_stale_check] then mtime-skip them instead of re-reading forever.
    Do not invent fake ideas or edges. `extract_version` mismatch and hard rebuild still force
    re-scan. Idea listing stays correct with empty documents. Diagnostics must not call a
    no-row Empty write `persisted` (use `empty`).
    Related: [index_code_files], [sequencing.soft_sync], [nonblocking_index].
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/sync.rs"]
        ["../../crates/reqlan-index/src/store.rs"]
        ["../../packages/analytical/src/index-store/workspace-index.ts"]
        ["../../packages/analytical/src/index-store/index-diagnostics-store.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/code_file_index.rs:soft_sync_mtime_skips_code_files_without_comment_refs"]
        ["../../crates/reqlan-index/tests/code_file_index.rs:dropping_comment_refs_keeps_document_without_edges"]
        ["../../crates/reqlan-index/tests/code_file_index.rs:hard_rebuild_rescans_negative_cached_code_file"]
        ["../../packages/analytical/test/workspace-index.test.ts:soft sync mtime-skips code files without comment refs"]
    )
}

single_sync_walk {
    One native directory walk records base roots, `.rq` paths, and allowlisted code paths.
    The walk does not read file bodies.
    Startup, Refresh, and create-base each run that walk once. They do not call `findFiles` and they do not run a second native `syncWorkspace` walk.
    Soft sync indexes the path list and skips unchanged mtimes.
    Idle stale check stats paths already stored in SQLite. New files arrive from the file watcher.
    The language server does not walk. The extension sends the base roots after the scan.
    Overlapping callers share one in-flight scan.
    CLI and MCP `sync_workspace` uses the same walk (one pass, stop at nested bases).
    [index_cache_reuse]
    [sequencing.soft_sync]
    [sequencing.scan_limits]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/scan.rs"]
        ["../../packages/analytical/src/native/scan-workspace.ts"]
        ["../../packages/extension/src/analytical_submodule/index-store/index-service.ts"]
        ["../../packages/analytical/src/index-store/workspace-index.ts"]
        ["../../crates/reqlan-lsp/src/session.rs"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/scan.rs:one_walk_returns_bases_rq_and_code_and_skips_ignored_dirs"]
        ["../../packages/extension/test/refresh-rediscovers-bases.test.ts:startup scan does not call findFiles"]
    )
}

single_open_store {
    The extension adapter owns a live [workspace_index] / SQLite connection per base.
    `getAnalysisApi()` / [analysis_runtime] must not open a second runtime that re-runs
    `ensure_ready` → `sync_workspace` when the adapter already synced.
    Reuse the open store for file-context, deprecation, and semantic commands.
    [index_cache_reuse]
    [consumers.extension_ui_consumers]
    @status draft
}

reuse_sqlite_edges_for_hops {
    Activity bar and Ideas Summary already query hop neighbourhoods from SQLite edges.
    Language-server reference ranking ([reference_code_completion_sequencing]) rebuilds
    adjacency from open Langium documents in [completion_provider].
    When the index is ready, completion hop ranking should prefer indexed edges
    (or a shared hop API) over a second AST-derived graph.
    [index_cache_reuse]
    [consumers.extension_ui_consumers]
    @status draft
}

path_completion_listing_cache {
    Import and anonymous file-path completion ([import_code_completion_ranking],
    [anonymous_reference_code_completion], [reference_code_completion_objects]) walk
    directories via [path_completion].
    Reuse directory listings across keystrokes (TTL cache) so each keystroke does not
    re-walk the filesystem; clear the cache in tests and on demand.
    [index_cache_reuse]
    @status draft
    @implementation (
        [path_completion]
    )
}

avoid_full_list_all_ideas {
    Prefer `fuzzySearch`, paged SQL, or catalog deltas over materialising every idea.
    The language server looks up one idea name with `ideas_named`, or a prefix with `idea_names_with_prefix`.
    It does not call `list_all_ideas` for completion, code actions, references, or rename.
    It does not keep a pushed name catalog in the host.
    SQLite answers those lookups.
    Avoid:
    - reference-search calling `listAllIdeas` when `fuzzySearch` pages suffice
    - wildcard / AI pickers holding the full catalog when a page walk or search hit list suffices
    - Ideas Summary `sendFullGraph` dumping all ideas and edges ([graphical_graph] guidance)
    - export attribute loads that pull every raw idea when the export scope is a file set
    - soft sync / batch index calling `list_all_ideas` once per file ([sync_pass_idea_catalog])
    [index_cache_reuse]
    [consumers.extension_ui_consumers]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/store.rs"]
        ["../../crates/reqlan-lsp/src/session.rs"]
        ["../../packages/analytical/src/index-store/sqlite-store.ts"]
        ["../../packages/analytical/src/export/build-export-snapshot.ts"]
        ["../../packages/extension/src/extension/reference-search-panel.ts"]
        ["../../packages/extension/src/extension/wildcard-matches-panel.ts"]
        ["../../packages/extension/src/agent_module/ai_commands/register-ai-commands.ts"]
        ["../../packages/extension/src/extension/register-name-catalog-sync.ts"]
    )
    @tests (
        ["../../packages/extension/test/document-sync.test.ts"]
        ["../../crates/reqlan-lsp/tests/session.rs:uses_ideas_index_matches_when_documents_are_not_loaded"]
    )
}

sync_pass_idea_catalog {
    One sync or batch index pass loads the idea catalog once (`list_all_ideas` / `load_idea_catalog`).
    It passes that catalog by mutable reference while indexing; it does not clone the full Vec per `.rq` file
    and does not reload SQLite ideas per code file.
    After each `.rq` persist, drop that file's prior catalog rows and push the new idea names
    (rename-safe; wildcards in later files see ideas already indexed in this pass).
    Code-document refresh after an idea-name change reuses the same in-memory catalog.
    Extension soft sync opens a native catalog session (`beginIndexPass` / `endIndexPass`) around the
    per-file loop so `indexFile` does not reload ideas each time; `indexFiles` / `index_paths` keep one
    catalog for an explicit path list without a second walk.
    Single-file watcher enqueue may still call `list_all_ideas` once (one file, not a full pass).
    [index_cache_reuse]
    [avoid_full_list_all_ideas]
    ["./sequencing.rq".soft_sync]
    ["./indexer.rq".index_code_files]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/sync.rs"]
        ["../../crates/reqlan-analytical/src/workspace_index.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/index-store/workspace-index-sync.ts"]
        ["../../packages/analytical/src/native/native-workspace-index.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/sync.rs:soft_sync_skips_unchanged_mtime"]
        ["../../crates/reqlan-index/tests/sync.rs:sync_pass_catalog_sees_earlier_file_ideas_for_wildcards"]
        ["../../crates/reqlan-index/tests/sync.rs:sync_pass_catalog_drops_renamed_idea_names"]
        ["../../crates/reqlan-index/tests/sync.rs:index_paths_shares_one_catalog_across_files"]
    )
}

unify_inbound_indexes {
    Inlay hints and code lens must read inbound edges from [ideas_schema.edges_table],
    not Langium IndexManager.
    Query: edges whose `target_id` is an idea in the open file, plus `comment_link` /
    `file_reference` rows whose `target_file` matches that file.
    File-top CodeLens uses the `file_reference` subset
    (["../extension/language/syntax/features-syntax-highlighting.rq".file_inbound_code_lens]).
    The extension host runs the query and pushes a snapshot to the language server.
    The language server does not open SQLite ([consumers.extension_ui_consumers]).
    Updates follow index sync independently of open-file parse
    (["../language/syntax.rq".open_file_reference_sequencing], [inbound_snapshot_events]).
    Mutation hooks already use the same store. Share one graph.
    Related: [index_cache_reuse], ["../indexer/indexer.rq".local_symbolic_analysis],
    ["../extension/language/syntax/features-syntax-highlighting.rq".inbound_inlay_index_performance].

    @status done
    @implementation (
        ["../../packages/analytical/src/index-store/sqlite-store.ts"]
        ["../../packages/analytical/src/core/inbound-file-referencers.ts"]
        ["../../packages/language/src/reqlan-inlay-hint-provider.ts"]
        ["../../packages/language/src/reqlan-inbound-reference-inlay-label.ts"]
        ["../../packages/language/src/reqlan-inbound-snapshot.ts"]
        ["../../packages/language/src/reqlan-reference-code-lens.ts"]
        ["../../packages/language/src/reqlan-file-inbound-code-lens.ts"]
        ["../../packages/extension/src/extension/register-inbound-sqlite-sync.ts"]
        ["../../packages/extension/src/extension/inbound-snapshot-push.ts"]
        ["../../crates/reqlan-index/src/queries.rs"]
    )
    @tests (
        ["../../crates/reqlan-index/src/queries.rs:inbound_for_file_returns_edges_targeting_ideas_in_file"]
        ["../../crates/reqlan-index/src/queries.rs:inbound_for_file_returns_file_reference_targeting_file"]
        ["../../packages/language/test/inbound-referencer-index-perf.test.ts:inlay referencers come from the pushed snapshot, not findAllReferences"]
        ["../../packages/analytical/test/inbound-file-referencers.test.ts"]
        ["../../packages/extension/test/inbound-snapshot-push.test.ts"]
    )
}

inbound_snapshot_events {
    Host→LSP inbound snapshots are event-driven and incremental.
    Push only when the ideas index is ready (catalog update, ready-edge, visible-editor change, or window focus).
    While Syncing or not ready, do not push an empty batch that clears the language-server last-good map;
    set a deferred flag and flush on the next ready event.
    The language client often starts before the index — registration must ensure-open / defer, not skip forever.
    Each notification is a per-document merge for visible editors; URIs not in the batch stay as last-good until replaced or the document closes.
    After a single-file enqueue reaches ready, notify catalog so consumers get a ready-state event
    (mid-sync catalog notifies alone are not enough).
    Coalesce concurrent push work so catalog spam drains to one ready pass.
    Related: [unify_inbound_indexes],
    ["../extension/language/support/open-file-sequencing.rq".lazy_features_after_outbound],
    ["../extension/language/syntax/features-syntax-highlighting.rq".inbound_inlay_index_performance].

    @status done
    @implementation (
        ["../../packages/extension/src/extension/inbound-snapshot-schedule.ts"]
        ["../../packages/extension/src/extension/inbound-snapshot-push.ts"]
        ["../../packages/extension/src/extension/register-inbound-sqlite-sync.ts"]
        ["../../packages/analytical/src/index-store/workspace-index.ts"]
        ["../../packages/language/src/reqlan-inbound-snapshot.ts"]
    )
    @tests (
        ["../../packages/extension/test/inbound-snapshot-push.test.ts"]
        ["../../packages/language/test/inbound-snapshot-store.test.ts"]
        ["../../packages/analytical/test/workspace-index.test.ts:enqueueIndex notifies catalog when ready"]
    )
}

overview_coverage_reuse {
    Overview coverage must not re-walk the base with `.rqignore` when a soft sync just
    produced an equivalent file set.
    Reuse the last sync document list or a cheap SQLite documents query.
    [index_cache_reuse]
    [sequencing.soft_sync]
    @status draft
}

batched_document_upsert {
    Persist N extracted documents in one SQLite transaction (`BEGIN` … `COMMIT`).
    Each document still replaces its ideas and edges the same way as a single-file upsert.
    Soft sync may call this after extract so many changed files share one commit.
    Empty code files may write nothing; batching helps when many files do persist.
    On error or cancel of the batch write: fail the whole batch and roll back.
    Do not commit a successful prefix. Same atomicity as multi-document delete.
    Single-file upsert stays for watcher incremental ([sequencing.watcher_incremental]).
    Related: [index_cache_reuse], [sequencing.soft_sync], [ideas_schema.documents_table],
    [nonblocking_index].

    @status done
    @implementation (
        [index_queries]
        [index_store]
    )
    @tests (
        ["../../crates/reqlan-index/tests/batch_upsert.rs:persist_extracted_batch_commits_multiple_documents"]
        ["../../crates/reqlan-index/tests/batch_upsert.rs:persist_extracted_batch_empty_is_noop"]
        ["../../crates/reqlan-index/tests/batch_upsert.rs:upsert_documents_rolls_back_entire_batch_on_error"]
    )
}
