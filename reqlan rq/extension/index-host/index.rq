import "../../../packages/analytical/src/core/application-memory.ts" as application_memory_impl
import "../../../packages/analytical/src/core/rqignore.ts" as rqignore_impl
import "../../../packages/mcp/src/server.ts" as mcp_server
import "../../../packages/extension/src/analytical_submodule/index.ts" as analytical_submodule
import "./graph-analysers.rq" as graph_analysers
import "../../indexer/indexer.rq" as indexer
import "../host/configuration.rq" as configuration

application_memory {
    Base-local application memory for reqlan tools lives under `<base>/.reqlan/`.
    The presence of `.reqlan` **marks** a directory as a ["../../bases/base.rq".base]; each base owns its own store.
    Shared by the VS Code extension, ["../../cli/cli_package.rq".cli_package], and MCP ([mcp_server]) — not VS Code `globalStorageUri` / extension-private storage.
    The ideas graph index ([indexer.index_ideas] and [indexer.index_technology]) persists as `ideas-index.sqlite` inside that directory.
    Schema: ["../../indexer/sqlite-schema.rq".ideas_index_sqlite].
    Index timing diagnostics persist separately as `index-diagnostics.sqlite` ([index_diagnostics_store] / ["./index-diagnostics.rq".index_diagnostics]) so rebuilds of the ideas index do not wipe history.
    Click session state persists as `click-sessions.sqlite` (["../../cli/click.rq".click_session]) so agent/CLI click cursors survive ideas-index rebuilds.
    Diagnostics schema: ["../../indexer/diagnostics-schema.rq".diagnostics_sqlite].
    WAL sidecars and JSON siblings: ["../../indexer/sidecars.rq".reqlan_directory_layout].
    Export form defaults (all formats via ["../export/export.rq".export_webview], including HTML options in ["../export/html-export.rq".html_export_form]) persist as `export_settings.json` in the same directory (active base).
    Path ignore rules live as `.rqignore` in the same directory ([rqignore] / [configuration.configuration_rqignore]).
    Git ignore for SQLite stores lives as `.gitignore` in the same directory (["../../bases/base.rq".base_initialisation_ignore]).
    Path resolution is owned by [application_memory_impl] (`resolveApplicationMemoryPath`); consumers must use it (or `REQLAN_INDEX_PATH` override for a single store) so tools read and write the same store for a given base.
    Multi-base discovery/registry: ["../../bases/base.rq".multi_base_environment]. Index engine ownership: ["../../indexer/indexer.rq".ownership]. Extension wiring: [analytical_submodule].
    Aligns with ["../../cli/cli_package.rq".function_parity]: shared analytical memory, not host-only state.
    @status done
}

index_diagnostics_store {
    Per-base diagnostic timing index at `<base>/.reqlan/index-diagnostics.sqlite`.
    Sibling of `ideas-index.sqlite`; not deleted by Clear & rebuild.
    Records sync runs and per-file durations for ["./index-diagnostics.rq".index_diagnostics_metrics].
    Webview: ["./index-diagnostics.rq".index_diagnostics_webview].
    @implementation (
        ["../../../packages/analytical/src/index-store/index-diagnostics-store.ts"]
        [application_memory_impl]
    )
    @tests (
        ["../../../packages/analytical/test/index-diagnostics.test.ts"]
    )
    @status done
}

rqignore {
    `.reqlan/.rqignore` filters which paths discovery and indexing crawl, using gitignore syntax relative to the base root.
    Owned by [rqignore_impl] in `@reqlan/analytical` so CLI and editor share behaviour.
    Defaults cover `node_modules/`, virtualenvs, build dirs (`bin/`, `generated/`, `out/`), VCS/editor stores, database files (`*.db3`, sqlite) and SQLite sidecars, binary globs ([binary_ignore]), `*.html`, secrets, and hidden entries.
    Walks also skip common files that have no comments ([commentless_file_ignore]).
    New bases seed the file via [rqignore_initialisation].
    Product configuration statement: [configuration.configuration_rqignore].
    @implementation (
        [rqignore_impl]
        [application_memory_impl]
        ["../../../packages/analytical/src/core/rqignore.ts"]
        ["../../../crates/reqlan-index/src/ignore.rs"]
        ["../../../packages/analytical/src/core/create-base.ts"]
        ["../../../packages/analytical/src/core/base-discovery.ts"]
        ["../../../packages/analytical/src/index-store/workspace-index.ts"]
    )
    @tests (
        ["../../../packages/analytical/test/rqignore.test.ts"]
        ["../../../packages/analytical/test/rqignore.test.ts:seeded rqignore comments explain all features"]
        ["../../../packages/analytical/test/create-base.test.ts:seeds .reqlan/.rqignore when creating a new base"]
        ["../../../packages/analytical/test/workspace-index.test.ts:skips .rq files under rqignore patterns"]
        ["../../../crates/reqlan-index/tests/sync.rs:default_rqignore_skips_node_modules"]
    )
    @status done
}

rqignore_initialisation {
    New bases seed `.reqlan/.rqignore` with comments that explain every feature of [rqignore], [binary_ignore], and [commentless_file_ignore].
    Written when a base is created: ["../host/installation.rq".base_rqignore_seed] / ["../../bases/base.rq".base_initialisation].
    Comments cover purpose (discovery and index walks), base-root relative paths, gitignore syntax, last matching rule, `!` negation, built-in defaults that always apply, binary opt-in, hidden paths, `*.secret.rq`, SQLite sidecars, files that have no comments ([commentless_file_ignore]), and `.reqlan/` itself.
    The seeded file is the editable surface. Built-in rules still apply if a user deletes a line.
    Existing `.rqignore` files are not rewritten (["../host/installation.rq".base_installation] is idempotent).
    @status done
    @implementation (
        [rqignore_impl]
        ["../../../packages/analytical/src/core/rqignore.ts"]
        ["../../../crates/reqlan-index/src/ignore.rs"]
        ["../../../packages/analytical/src/core/create-base.ts"]
    )
    @tests (
        ["../../../packages/analytical/test/rqignore.test.ts:defaultRqIgnoreFileContents documents gitignore-style defaults"]
        ["../../../packages/analytical/test/rqignore.test.ts:seeded rqignore comments explain all features"]
        ["../../../crates/reqlan-index/src/ignore.rs:seeded_rqignore_explains_features"]
        ["../../../packages/analytical/test/create-base.test.ts:seeds .reqlan/.rqignore when creating a new base"]
    )
}

binary_ignore {
    Discovery, coverage, and index walks skip binary files by default.
    Built-in [rqignore] patterns include a broad set of binary globs (images, archives, packages, native objects, fonts, media, and office files).
    Opt in with a gitignore negation in `.reqlan/.rqignore`. Example: `!*.bin` includes files with a `.bin` extension.
    Opted-in files can receive ["../../indexer/indexer.rq".index_code_files] comment indexing. They are not parsed as `.rq` sources.
    The editor source watcher stays on allowlisted text extensions. A soft sync indexes opted-in binary paths from the scan list. Idle stats stored paths and does not walk.
    Same filter as [configuration.configuration_rqignore].
    @status done
    @implementation (
        [rqignore_impl]
        ["../../../packages/analytical/src/core/rqignore.ts"]
        ["../../../crates/reqlan-index/src/ignore.rs"]
        ["../../../crates/reqlan-index/src/sync.rs"]
    )
    @tests (
        ["../../../packages/analytical/test/rqignore.test.ts:defaults ignore node_modules, venv, db3, and binary paths"]
        ["../../../packages/analytical/test/rqignore.test.ts:inverse rqignore patterns opt binary files back in"]
        ["../../../crates/reqlan-index/src/ignore.rs:default_rqignore_skips_binary_files_until_negated"]
        ["../../../crates/reqlan-index/tests/code_file_index.rs:skips_binary_comment_files_unless_rqignore_negation"]
        ["../../../crates/reqlan-index/tests/sync.rs:default_rqignore_skips_node_modules"]
    )
}

text_prefix_skip {
    Before any index content read, inspect at most the first 8 KiB.
    Skip the file when that prefix has a NUL, a UTF-16 BOM (`FF FE` or `FE FF`), or invalid UTF-8.
    A trailing incomplete UTF-8 code unit is not a skip: the rest of the file may finish the character.
    Skip when the file is larger than 1 MiB.
    A rejected prefix is not followed by a read of the remainder.
    `.rq` files and allowlisted code files use the same check.
    This is in addition to [binary_ignore] extension globs.
    @status done
    @implementation (
        ["../../../crates/reqlan-index/src/text.rs"]
        ["../../../crates/reqlan-index/src/sync.rs"]
    )
    @tests (
        ["../../../crates/reqlan-index/src/text.rs:nul_rejects"]
        ["../../../crates/reqlan-index/src/text.rs:utf16_bom_rejects"]
        ["../../../crates/reqlan-index/src/text.rs:invalid_utf8_rejects"]
        ["../../../crates/reqlan-index/src/text.rs:trailing_incomplete_utf8_is_not_a_reject"]
        ["../../../crates/reqlan-index/tests/scan.rs:prefix_skip_does_not_index_non_text"]
    )
}

commentless_file_ignore {
    Discovery, coverage, and index walks skip common files that have no comment syntax.
    The set includes JSON (`.json`, `.jsonl`, `.ndjson`), tabular data (`.csv`, `.tsv`), lockfiles, checksums, minified scripts, source maps, notebooks, and certificates.
    These files cannot hold `rq:` comment references.
    SQLite WAL, SHM, and journal sidecars stay with the database patterns in [rqignore] (`*.sqlite-wal`, `*.sqlite-shm`, `*.sqlite-journal`, and the same suffixes on `.sqlite3`, `.db`, and `.db3`).
    Opt in with a gitignore negation in `.reqlan/.rqignore`. Example: `!*.json`.
    JSON with comments (`.jsonc`, `.json5`) stays eligible for ["../../indexer/indexer.rq".index_code_files].
    The seeded file lists the same patterns ([rqignore_initialisation]).
    @status done
    @implementation (
        [rqignore_impl]
        ["../../../packages/analytical/src/core/rqignore.ts"]
        ["../../../crates/reqlan-index/src/ignore.rs"]
    )
    @tests (
        ["../../../packages/analytical/test/rqignore.test.ts:defaults ignore json, sqlite sidecars, and files without comments"]
        ["../../../packages/analytical/test/rqignore.test.ts:inverse rqignore patterns opt json back in"]
        ["../../../crates/reqlan-index/src/ignore.rs:default_rqignore_skips_files_without_comments_until_negated"]
        ["../../../crates/reqlan-index/src/ignore.rs:seeded_rqignore_explains_features"]
    )
}

idea_index_triggers {
    Refresh automatically on `.rq` file change via watchers ([graph_analysers.indexing_trigger_filesave]).
    Idle: cheap background staleness check — [graph_analysers.indexing_trigger_auto].
    Git-dates fill is not an index trigger; it is a later analyser with
    ["./git-codelens.rq".git_dates_rate_cap].
}


git_information_capture {
    Capture and surface git development history for requirements and files — not only working-tree staging status.
    On-demand / index-accessible:
        - ownership and top authors (name; email when available)
        - creator (first introduction) and last meaningful modification
        - edit frequency / commit count for the focus path or idea line range
        - recent commit trail (subject, author, authoredAt, short hash) for the ["../local-context/context-scope.rq".git_context] lens
    Idea dates and change counts come from [indexer.git_dates] /
    ["./git-codelens.rq".git_dates_background_indexing], not from a git walk on every save
    (["./git-codelens.rq".git_dates_rate_cap]).
    Activity Bar git CLI calls stay hidden on Windows (["../../core_analysis/core.rq".consumption_silence]).
    Future: adjacency score from edit state and frequency of neighbours.
    Feeds ["../local-context/context-scope-v2.rq".development_history_signals] and ["../local-context/activitybar-panels/current_context_scope.rq".git_history_lens].
}
