from "./features-graph.rq" import graph_design
from "./module/index.rq" import application_memory
import "../packages/language/src/reqlan-comment.langium" as comment_grammar
import "../../packages/analytical/src/core/application-memory.ts" as application_memory_impl
import "../../packages/analytical/src/create-runtime.ts" as analysis_runtime
import "../../packages/extension/src/analytical_submodule/index-store/index-service.ts" as index_service

index_ideas {
    The extension should maintain an index of all ideas across the workspace for fast lookup and navigation.
    The index should update incrementally as .rq files change.
    Persistence lives in [application_memory], shared with CLI and MCP — not VS Code extension storage.
}

index_technology {
    The [index_ideas] graph database is sql.js SQLite, aligned with [graph_design].
    On-disk location is [application_memory] (`<workspace>/.reqlan/ideas-index.sqlite`), not `context.globalStorageUri`.
    Implementation: [application_memory_impl], [index_service], and headless [analysis_runtime] for CLI/MCP.
}

indexing_incrementality indexing should be incremental

indexing_trigger_filesave indexing should be triggered by manual .rq file changes.
indexing_trigger_manual indexing should be triggered by manual indexing commands.
indexing_trigger_auto indexing should be triggered by automatic indexing when the workspace is idle; and on application open.

list_all_ideas {
    The extension should provide a command to list all ideas in the workspace with file location and summary.
}

index_comment_reference_inclusion {
    The [comment_grammar.comment] comments should be included as a node type in the index
    @todo
}

file_related_requirements {
    The extension should provide a view or command to get requirements relating to the currently open file.
    File-related lookup should follow both explicit file references and comment rq: links in that file.
}

deprecation_impact_analysis {
    The extension should analyse the impact of deprecated ideas on dependent requirements.
    Deprecation analysis should report downstream ideas that reference or depend on deprecated items.
}

git_dates {
    The extension should surface creation and last-modified dates for ideas via git history where available.
}

completion_tracking {
    The extension should track and surface completion, outstanding work, and open issues across the requirement graph.
    Completion tracking should derive from @status, @tags, and other lifecycle attributes where present.
}

local_graph_analysis {
    The extension should provide a function to access a small slice of the graph around a given idea.
}

semantic_analysis {
    Search graph for ideas related to a given idea or ideaset.
}