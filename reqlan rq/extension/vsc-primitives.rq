code_actions {
    Language-server code actions for `.rq` files, plus comment-file Quick Fixes for ignore-error:
    - Quick fixes for unresolved references (add import, rewrite qualified ref, search, create file) — ["./language-support/features-imports.rq".import_error]
    - Refactor: search/replace or wrap as idea reference — ["./features-commands.rq".search_code_actions]
    - Refactor: move or delete an idea declaration — ["./refactor_support.rq".refactor_symbol_move] ["./refactor_support.rq".refactor_symbol_delete]
    - File-level source action: barrel page — ["./features-commands.rq".barrel_page]
    - Quick Fix: insert `//rq-ignore-error` before a line with diagnostics — ["./features-commands.rq".code_actions_ignore_error]
    - Quick Fix: create a missing local idea below the idea that contains the unresolved reference — ["./features-commands.rq".create_idea_below_idea_containing_unresolved_reference_under_cursor]
    Command-backed search/replace and barrel actions omit LSP command arguments so VS Code does not cache disposable delegating ids; the extension resolves the active editor (or document) when the command runs.
    @status done
    @implementation (
        ["../../packages/language/src/reqlan-code-action-provider.ts"]
        ["../../packages/extension/src/extension/register-import-error-commands.ts"]
        ["../../packages/extension/src/extension/main.ts"]
        ["../../packages/extension/src/language/main.ts"]
        ["../../packages/extension/src/refactor_module/register-idea-refactor-commands.ts"]
        ["../../packages/extension/src/refactor_module/register-barrel-page-command.ts"]
        ["../../packages/extension/src/extension/register-ignore-error-code-actions.ts"]
        ["../../packages/language/src/reqlan-ignore-error-action.ts"]
        ["../../packages/language/src/reqlan-create-idea-below.ts"]
    )
    @tests (
        ["../../packages/language/test/code-actions.test.ts"]
        ["../../packages/extension/test/extension-package.test.ts"]
        ["../../packages/extension/test/barrel-page-apply.test.ts"]
        ["../../packages/language/test/idea-refactor.test.ts"]
        ["../../packages/language/test/ignore-error-action.test.ts"]
        ["../../packages/extension/test/ignore-error-code-action.test.ts"]
        ["../../packages/language/test/code-actions.test.ts:creates the missing idea below the containing idea when only one is unresolved"]
        ["../../packages/language/test/code-actions.test.ts:offers all or a specific unresolved idea when the caret idea has several"]
    )
}

