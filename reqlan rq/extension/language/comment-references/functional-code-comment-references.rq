
from "../../../language/syntax.rq" import comment_reference_resolution_error

references_in_functional_code_comments {
    Comments in functional code should be able to reference reqlan ideas using the an `rq:` prefixed to an idea: `rq:[idea]` as demonstrated in python, but actually applicable to any language's comment context:
    ```python
    # rq:[myidea]
    # This has been built to comply with a qualified comment reference — which is very important.
    ```

    Editor hosts are every language except [comment_reference_language_blocklist].
    With the rust language server, a resolved `rq:[…]` site is Ctrl+click navigable via go-to-definition.
    File document links stay out of the editor (["../syntax/features-syntax-highlighting.rq".editor_reference_activation]).
    Comment `rq:[…]` sites use TextMate `meta.link.reqlan markup.underline` so the resting editor shows they are link-shaped ([comment_reference_resting_underline]).
    After that goto, Alt+Left restores the comment-host caret ([comment_reference_navigate_back]).
    Missing ideas keep the error underline and have no definition target.
    Relates to ["../../mutation/refactor_support.rq".comment_reference_refactor_support], [comment_reference_import_root_alias],
    ["../support/language-server-rust.rq".language_server_rust],
    ["../syntax/features-syntax-highlighting.rq".editor_reference_activation].

    @demos (
        ["./features-code-comment.text.js"]
        ["./features-code-comment.text.py"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../packages/extension/src/extension/main.ts"]
        ["../../../../packages/extension/src/extension/register-comment-reference-links.ts"]
        ["../../../../packages/extension/grammars/reqlan-comment.injection.json"]
    )
    @tests (
        ["../../../../packages/language/test/linking.test.ts:comment references in source files resolve to rq ideas"]
        ["../../../../packages/language/test/references.test.ts:finds rq: references in feature demo source files"]
        ["../../../../packages/language/test/references.test.ts:finds rq: comment references in python triple-quoted comments"]
        ["../../../../crates/reqlan-lsp/tests/session.rs:comment_links_share_one_resolution"]
        ["../../../../crates/reqlan-lsp/tests/session.rs:comment_definition_follows_a_resolved_rq_reference"]
        ["../../../../packages/extension/test/editor-link-activation.test.ts:comment injection link scope includes markup.underline"]
        ["../../../../packages/extension/test/editor-link-activation.test.ts:package.json contributes comment.rq.injection"]
    )
    @status done
}

comment_reference_resting_underline {
    In non-`.rq` source comments, every `rq:[…]` token must show a resting underline so it is clear the site is link-shaped.
    Use TextMate scope `meta.link.reqlan markup.underline` via the comment injection grammar.
    Do not rely on file document links for that cue — those stay stripped (["../syntax/features-syntax-highlighting.rq".editor_reference_activation]).
    Navigation remains Ctrl+click go-to-definition for resolved sites ([references_in_functional_code_comments]).
    Related: [references_in_functional_code_comments], ["../syntax/features-syntax.rq".comment_support].

    @status done
    @implementation (
        ["../../../../packages/extension/grammars/reqlan-comment.injection.json"]
        ["../../../../packages/extension/package.json"]
    )
    @tests (
        ["../../../../packages/extension/test/editor-link-activation.test.ts:comment injection link scope includes markup.underline"]
        ["../../../../packages/extension/test/editor-link-activation.test.ts:package.json contributes comment.rq.injection"]
    )
}

comment_reference_navigate_back {
    A go-to-definition JUMP from a comment `rq:[…]` host must push the pre-jump caret onto the same navigate-back stack as `.rq` jumps.
    The stack tracks every non-blocklisted language (["../../../../packages/extension/src/extension/comment-reference-languages.ts"]) as well as `.rq`.
    Only landings in `.rq` / `reqlan` are recorded, so other language servers do not fill the stack.
    Alt+Left (`reqlan.navigateBack`) restores that caret when `reqlan.canNavigateBack` is set, in any focused editor.
    Related: [references_in_functional_code_comments], [comment_reference_language_blocklist], ["../syntax/features-syntax-highlighting.rq".editor_reference_activation].

    @status done
    @implementation (
        ["../../../../packages/extension/src/extension/definition-navigation.ts"]
        ["../../../../packages/extension/src/extension/definition-navigation-stack.ts"]
        ["../../../../packages/extension/src/extension/register-definition-navigation.ts"]
        ["../../../../packages/extension/package.json"]
    )
    @tests (
        ["../../../../packages/extension/test/definition-navigation.test.ts:tracks non-blocklisted languages for navigate-back"]
        ["../../../../packages/extension/test/definition-navigation.test.ts:records only landings in reqlan targets"]
        ["../../../../packages/extension/test/definition-navigation.test.ts:records a cross-file command jump from the prior caret"]
        ["../../../../packages/extension/test/definition-navigation.test.ts:navigate-back keybinding is not limited to .rq editors"]
    )
}

comment_reference_language_blocklist {
    Comment rq editor features (goto, diagnostics, ignore actions, navigate-back origin tracking) apply to every language except a small blocklist.
    The blocklist is `reqlan` plus non-source editor buffers (log, search-result, SCM input, git commit/rebase, github-issues).
    The rust language client uses a file-scheme document selector and skips sync for blocklisted languages.
    TextMate resting underline injects into a wide `injectTo` scope list (best-effort; goto still works without a matching grammar scope).
    Related: [references_in_functional_code_comments], [comment_reference_resting_underline], ["../../../language/syntax.rq".comment_reference].

    @status done
    @implementation (
        ["../../../../packages/extension/src/extension/comment-reference-languages.ts"]
        ["../../../../packages/extension/src/extension/main.ts"]
        ["../../../../packages/extension/src/extension/register-definition-navigation.ts"]
        ["../../../../packages/extension/src/extension/register-comment-reference-links.ts"]
        ["../../../../packages/extension/src/extension/register-ignore-error-code-actions.ts"]
        ["../../../../packages/extension/package.json"]
    )
    @tests (
        ["../../../../packages/extension/test/definition-navigation.test.ts:tracks non-blocklisted languages for navigate-back"]
        ["../../../../packages/extension/test/editor-link-activation.test.ts:package.json contributes comment.rq.injection"]
        ["../../../../packages/extension/test/comment-reference-languages.test.ts:blocklist excludes reqlan and editor chrome"]
    )
}


comment_reference_resolution_error_state {
    [comment_reference_resolution_error]
    The language server must share one resolution result for clickable links and the error underline.
    Resolve comment references once against the loaded idea index, then reuse that result for both consumers.
    When you create an idea that matches a comment reference, the language server must clear the underline and the missing-idea message.
    Resolution and the index should be performed once and shared between consumers.
    @status done
    @implementation (
        ["../../../../packages/language/src/reqlan-comment-diagnostics.ts"]
        ["../../../../packages/language/src/reqlan-neighbor-parse.ts"]
        ["../../../../packages/language/src/reqlan-document-builder.ts"]
        ["../../../../packages/language/src/reqlan-document-link-provider.ts"]
        ["../../../../packages/language/src/reqlan-validator.ts"]
        ["../../../../packages/extension/src/extension/register-comment-reference-links.ts"]
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../crates/reqlan-index/src/comment.rs"]
    )
    @tests (
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:shares one presentation so a matching idea clears the underline and adds a link"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:publishes a missing-idea diagnostic and no document link until the idea exists"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:clears the underline and creates a link after a matching idea is added"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:relinks comment references only when the target file changes"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:revalidates comment-reference underlines when a matching idea is created on disk"]
        ["../../../../packages/language/test/outbound-hop.test.ts:comment references confirm the neighbor idea without loading Langium"]
        ["../../../../crates/reqlan-lsp/tests/session.rs:comment_links_share_one_resolution"]
        ["../../../../crates/reqlan-lsp/tests/session.rs:comment_definition_follows_a_resolved_rq_reference"]
    )
}

comment_reference_import_root_alias {
    Qualified comment references use the same path forms as imports, including import-root aliases such as `@/`.
    `rq:["@/path/relative/to/import/root.rq".idea]` resolves against the alias's import-root directory (workspace folder by default), not the source file directory.
    `@reqs` without a following `/` is not an alias. Configured aliases and roots follow ["../../../language/imports.rq".configuration_import_root_alias] and ["../../host/configuration.rq".configuration_import_roots].
    The language server applies this when resolving comment references in `.rq` files. The extension applies the same core resolver for `rq:[…]` links in non-`.rq` source.
    Related: ["../../../language/syntax.rq".comment_reference], [references_in_functional_code_comments], ["../../../language/imports.rq".import_paths].

    @status done
    @implementation (
        ["../../../../packages/language/src/reqlan-path-resolve.ts"]
        ["../../../../packages/language/src/reqlan-comment-diagnostics.ts"]
        ["../../../../packages/language/src/reqlan-comment-resolver.ts"]
        ["../../../../packages/extension/src/extension/comment-reference-path-context.ts"]
        ["../../../../packages/extension/src/extension/register-comment-reference-links.ts"]
        ["../../../../crates/reqlan-index/src/comment.rs"]
        ["../../../../crates/reqlan-parse/src/path.rs"]
    )
    @tests (
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:creates a document link for an import-root aliased comment reference"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:does not treat @/ as a path relative to the source file"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:resolves a configured alias in a comment reference"]
        ["../../../../packages/language/test/comment-reference-resolution.test.ts:accepts an import-root aliased comment reference in a loaded document"]
        ["../../../../packages/language/test/path-resolve.test.ts:resolveAuthoredFsPath joins aliased remainder to the workspace folder"]
        ["../../../../packages/language/test/path-resolve.test.ts:pathResolveContextFromWorkspaceFolders picks the longest matching folder"]
        ["../../../../packages/extension/test/comment-reference-path-context.test.ts:resolves @/ against the workspace folder for extension comment links"]
        ["../../../../crates/reqlan-index/src/comment.rs:resolves_aliased_qualified_comment_path"]
        ["../../../../crates/reqlan-lsp/tests/session.rs:comment_links_share_one_resolution"]
    )
}