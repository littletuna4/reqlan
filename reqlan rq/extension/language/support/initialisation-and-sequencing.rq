from "../../../core-architecture.rq" import language_server
from "./open-file-sequencing.rq" import open_file_algorithm, ast_lifecycle

lsp_file_watch {
    The language server must register workspace file watchers for `.rq` files only.
    It must not register a recursive all-files watcher.
    Watched-file events whose path contains a `node_modules`, `.git`, `.reqlan`, `out`, or `dist` segment must not start a document rebuild.
    Directory URIs without a trailing slash, Windows paths, and percent-encoded URIs must use the same segment rules.
    A kept `.rq` change replaces that buffer's model when the text changed ([ast_lifecycle]).
    Related: [language_server], [index_file_search_coalesce], [open_file_algorithm].
    @status done
    @implementation (
        ["../../../../packages/language/src/reqlan-document-update-handler.ts"]
        ["../../../../packages/language/src/reqlan-module.ts"]
    )
    @tests (
        ["../../../../packages/language/test/document-update-watch.test.ts"]
        ["../../../../packages/language/test/document-update-watch.test.ts:registers .rq globs only"]
        ["../../../../packages/language/test/document-update-watch.test.ts:classifies Windows and directory URIs by path segment"]
        ["../../../../packages/language/test/document-update-watch.test.ts:drops noisy events and keeps .rq files"]
        ["../../../../packages/language/test/ast-lifecycle.test.ts:replaces the AST when this buffer text changes"]
    )
}

index_file_search_coalesce {
    Index startup does not call `findFiles` or ripgrep / `searchtext.exe`.
    The native workspace scan (["../../../indexer/cache-reuse.rq".single_sync_walk]) is the one directory walk.
    Overlapping rediscover and sync callers share that in-flight scan.
    The scan applies `.rqignore` (["../../../indexer/indexer.rq".nonblocking_index]).
    Related: [lsp_file_watch], ["../../index-host/index.rq".rqignore], ["../../../indexer/sequencing.rq".scan_limits].
    @status done
    @implementation (
        ["../../../../packages/extension/src/shared/share-in-flight.ts"]
        ["../../../../packages/extension/src/analytical_submodule/index-store/index-service.ts"]
    )
    @tests (
        ["../../../../packages/extension/test/share-in-flight.test.ts"]
    )
}
