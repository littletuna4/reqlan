from "./language-server-errors.rq" import general_errors
from "../vsc-primitives.rq" import code_completion, code_actions, quick_fixes
from "../syntax/features-syntax-highlighting.rq" import reference_code_completion

remote_imports {
    Reqlan files should support importing requirements from remote urls.
    Remote import syntax should follow import "https://company.com/reqs/style.rq" as styleguide.
    The extension should resolve, cache, and validate remote imports.
    Barrel imports should be recommended for token efficiency when many symbols are needed from one remote file.
}

unused_import_diagnostics {
    Unused import bindings are detected per-file: every specifier of `from "path" import a, b`, every alias of `import "path" as ns`, and every bound name of `import "path".ideaset.idea [as alias]` is checked against all `Local` references (`[name]` / `[[name]]` or `[qualifier.idea]` where qualifier matches the alias) and `IdeaSet` members.
    If the config is `"warn"` (default), each unused specifier emits a `warning` diagnostic with `DiagnosticTag.Unnecessary`; `"error"` emits `error`; `"off"` suppresses the diagnostic entirely.
    The `reqlan.check` CLI accepts `--unused-imports <warn|error|off>`; per-file `.reqlan/config.json` `unusedImports` setting applies per source file's base.
    Lines after `//rq-ignore-error` suppress this diagnostic, matching ["../../../language/syntax.rq".comment_reference_ignore].
    In the editor, emit `DiagnosticSeverity.Warning` or `Error` with code `"unused-import"` and tag `Unnecessary`. Provide a Quick Fix that removes the specifier (with its comma) from `from` imports or the entire import line for namespace/qualified/bare imports.
    Related: ["../../../language/imports.rq".import_tokenisation], ["../../../language/imports.rq".anonymous_imports_allowed], [import_does_not_exist_error], ["../../host/configuration.rq".configuration_import_roots].

    @status in-progress
    @implementation (
        ["../../../../packages/extension/schemas/config.schema.json"]
        ["../../../../crates/reqlan-parse/src/ast.rs"]
        ["../../../../crates/reqlan-index/src/check/imports.rs"]
        ["../../../../crates/reqlan-lsp/src/analysis.rs"]
        ["../../../../crates/reqlan-lsp/src/code_actions.rs"]
        ["../../../../packages/extension/package.json"]
        ["../../../../packages/cli/src/commands/check.ts"]
    )
}

from_import_syntax {
    Multiple symbols should be allowd to be be imported with `from "path" import symbol1, symbol2, symbol3` syntax.
    Each imported name is its own link (["../../../language/imports.rq".import_from]).
}

import_error {
    "Could not resolve reference" errors offer Quick Fix code actions (lightbulb and editor right-click Quick Fix).
    Fixes:
        - Add import from a matching idea in an open document or the ideas index. The fix reads the ideas index for that name. It does not use a pushed full name catalog.
        - Rewrite the reference to an anonymous qualified form `["path".name]`
        - Search the index for matching ideas, ideasets, or files (same `reqlan.searchReference` path as [code_actions] / ["../../host/features-commands.rq".search_code_actions]), then insert an import
        - Create the idea in a new .rq file and import it
        - Create every unresolved local idea in this file, or in one new file with one from-import (["../../host/features-commands.rq".create_all_unresolved_ideas])
    [general_errors]
    [code_actions]
    [quick_fixes]
    @status done
    @implementation (
        ["../../../../packages/language/src/reqlan-code-action-provider.ts"]
        ["../../../../crates/reqlan-lsp/src/code_actions.rs"]
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../packages/extension/src/extension/register-import-error-commands.ts"]
    )
    @tests (
        ["../../../../packages/language/test/code-actions.test.ts"]
        ["../../../../packages/language/test/import-edits.test.ts"]
        ["../../../../packages/language/test/import-edits.test.ts:inserts after an existing different-path from-import with a blank line"]
        ["../../../../packages/language/test/import-edits.test.ts:inserts after an existing from-import with no blank line"]
        ["../../../../packages/language/test/import-edits.test.ts:inserts after an existing namespace import"]
        ["../../../../packages/language/test/import-edits.test.ts:inserts at the top when the file has no imports"]
        ["../../../../packages/language/test/import-edits.test.ts:appends to an existing same-path from-import"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:offers_add_import_and_rewrite_when_a_matching_idea_exists_elsewhere"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:uses_ideas_index_matches_when_documents_are_not_loaded"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:search_and_create_actions_invoke_extension_commands"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:appends_to_an_existing_from_import_for_the_same_path"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:appends_after_aliased_specifier_on_existing_from_import"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:offers_add_import_from_the_ideas_index"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:inserts_new_from_import_after_existing_from_import_with_blank_line"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:inserts_new_from_import_after_existing_from_import_without_blank_line"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:inserts_new_from_import_after_existing_namespace_import"]
        ["../../../../crates/reqlan-lsp/tests/code_actions.rs:inserts_from_import_at_top_when_file_has_no_imports"]
    )
}

implicit_file_extension {
    The import statements should not require an extension, i.e. it should assume ".rq" unless otherwise specified.
    An extensionless path resolves to the ".rq" file first, then to a literal extensionless file or folder.
    A path that already carries any extension is resolved exactly as written.
    Folder targets: [import_folder_targets].
    @implementation (
        ["../../../../packages/language/src/reqlan-imports.ts"]
        ["../../../../packages/language/src/reqlan-file-link-resolver.ts"]
        ["../../../../packages/language/src/reqlan-outbound-presentation.ts"]
        ["../../../../packages/language/src/reqlan-local-symbolic-links.ts"]
    )
    @tests (
        ["../../../../packages/language/test/implicit-import-extension.test.ts"]
        ["../../../../packages/language/test/outbound-hop.test.ts:confirms a neighbor idea when the authored path has no .rq extension"]
    )
}

import_folder_targets {
    An import path may refer to a folder.
    A folder is a valid import target when that path exists as a directory.
    Namespace import of a folder binds the alias to that folder, the same as a file.
    Extensionless paths still prefer a `.rq` file: [implicit_file_extension].
    Related: ["../../../language/imports.rq".import_paths], [import_does_not_exist_error], ["../syntax/features-syntax.rq".file_references].
    @status done
    @implementation (
        ["../../../../packages/language/src/reqlan-imports.ts"]
        ["../../../../packages/language/src/reqlan-file-link-resolver.ts"]
        ["../../../../packages/language/src/reqlan-validator.ts"]
    )
    @tests (
        ["../../../../packages/language/test/implicit-import-extension.test.ts:filesystem lookups append .rq then accept an existing directory"]
        ["../../../../packages/language/test/validating.test.ts:does not report an error when an import path is an existing folder"]
        ["../../../../packages/language/test/linking.test.ts:folder import paths produce folder document links"]
    )
}


import_code_completion {
    Import path code completion for `import` / `from` strings (and shared anonymous paths).
    The Rust server is the default engine. The TypeScript provider remains for the node engine.
    [code_completion]
    [import_code_completion_explicit_extension]
    [import_code_completion_path_segments]
    [import_code_completion_substring_match]
    [import_code_completion_ranking]
    [anonymous_reference_code_completion]
    [import_code_completion_auto_file_import]
    [import_code_completion_rendering]
    @status done
    @plan {
        goal
            The Rust language server completes import paths, anonymous file paths, and the from-import insert on a cross-file idea.
        constraints
            - Import strings offer `.rq` files and directories. Anonymous bracket paths offer every file and directory.
            - Rank by directory hops, then directories before files, then path. filterText is the typed prefix. The list is incomplete.
            - Cache directory listings. Do not walk again on the next keystroke inside the cache window.
            - A quoted path then a dot completes names in that one file. No from-import edit on that site.
            - Idea-graph hop ranking stays out of this work.
        steps
            1. Site detection, match, rank, and the cached walk.
            2. Session dispatch, qualified-file names, and the from-import edit.
            3. Triggers and a CompletionList.
            4. Tests and these requirement links.
        open
            - none
    }
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../crates/reqlan-lsp/src/server.rs"]
        ["../../../../crates/reqlan-lsp/src/code_actions.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
}

import_code_completion_rendering {
    Reference code completion for ideas from other files shows the relative import path in the completion detail.
    Same-file ideas omit the path detail.
    [reference_code_completion]
    [import_code_completion]
    [import_code_completion_auto_file_import]
    @status done
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:reference_completions_show_source_path_and_auto_import"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
}

import_code_completion_auto_file_import {
    When a code completion for an idea in another file is selected, the import should be automatically added to the current file.
    This prevents the user from selecting a presented idea, and then having to add the import for the same thing.
    Uses the same from-import insertion as [import_error] quick fixes; skips the edit when the idea is already imported.
    [reference_code_completion]
    [import_code_completion]
    [import_code_completion_rendering]
    [import_error]
    @status done
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:reference_completions_show_source_path_and_auto_import"]
        ["../../../../crates/reqlan-lsp/tests/completion.rs:skips_auto_import_when_the_idea_is_already_imported"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/session.rs"]
        ["../../../../crates/reqlan-lsp/src/code_actions.rs"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
        ["../../../../packages/language/src/reqlan-import-edits.ts"]
    )
}

import_code_completion_explicit_extension {
    Completions insert paths with an explicit `.rq` extension. [implicit_file_extension]
    Hand-written imports may still omit the extension; completion prefers the written form with `.rq`.

    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:completes_relative_import_paths_with_explicit_rq"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
}

import_code_completion_path_segments {
    In a folder context, show next path segments (directories with a trailing `/`).
    After `../`, offer `../path/` before nested `../path/file.rq`.
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:shows_next_path_segments_in_a_folder_context"]
        ["../../../../crates/reqlan-lsp/tests/completion.rs:ranks_directory_segments_before_nested_files"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
}

import_code_completion_substring_match {
    Filter path candidates by search within the path, not only a starts-with prefix.
    Typing `path` should match `../../parent/path.rq`.
    Typing `hellopath` should match `../../hello/inbetween/path/file.rq` (characters matched in order across path segments).
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:matches_import_paths_by_substring"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
}

import_does_not_exist_error {
    Imports show an underline error when the target file or folder does not exist.
    Imports also show an underline error when a named imported idea does not exist in the target file.
    An existing folder is not an error: [import_folder_targets].
    CI: ["../../../core_analysis/check.rq".check_unresolved_imports].
    [general_errors]
    @tests (
        ["../../../../packages/language/test/validating.test.ts"]
        ["../../../../packages/language/test/validating.test.ts:does not report an error when an import path is an existing folder"]
        ["../../../../crates/reqlan-index/tests/broken_references.rs:check_reports_missing_import_path"]
        ["../../../../crates/reqlan-index/tests/broken_references.rs:check_reports_missing_imported_idea"]
    )
    @implementation (
        ["../../../../packages/language/src/reqlan-validator.ts"]
        ["../../../../packages/language/src/reqlan-imports.ts"]
        ["../../../../crates/reqlan-index/src/check/imports.rs"]
        ["../../../../crates/reqlan-index/src/path_resolve.rs"]
    )
}

import_code_completion_ranking {
    Rank import path completions by directory proximity (hop count from the completing file's directory to the candidate's directory), then directories before files, then path alphabetically.
    Example: typing `../` ranks `../close.rq` before `../../../path.rq`.
    Emit sortText for that order, and set filterText so the editor does not re-rank by label fuzzy score over proximity.
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:ranks_import_paths_by_proximity_then_alphabetically"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
    )
}

anonymous_reference_code_completion {
    Anonymous imports should share the same code completion
    e.g. ["@/reqlan rq/extension/language/syntax/features-syntax.rq"] should complete the same as `import "@/reqlan rq/extension/language/syntax/features-syntax.rq" as code_completion`. they should share the same code and logic
    @tests (
        ["../../../../crates/reqlan-lsp/tests/completion.rs:anonymous_paths_share_import_path_completion"]
        ["../../../../crates/reqlan-lsp/tests/completion.rs:incomplete_anonymous_alias_paths_match_import_alias_paths"]
        ["../../../../packages/language/test/completion.test.ts"]
    )
    @implementation (
        ["../../../../crates/reqlan-lsp/src/path_completion.rs"]
        ["../../../../packages/language/src/reqlan-path-completion.ts"]
        ["../../../../packages/language/src/reqlan-completion-provider.ts"]
        ["../../../../packages/language/src/reqlan-completion-context.ts"]
    )
    
}
