
import "../core_analysis/html_export.rq" as html_export
from "./module/index.rq" import application_memory

html_export_form {
    HTML export options are hosted inside the general ["./features-export.rq".export_webview] (not a separate HTML-only panel).
    When format is HTML: simple options include base, scope, output folder, export name, and runtime mode.
    Advanced HTML settings should be collapsed by default behind an expandable section (template, cluster strategy, page-family toggles, file filters, url base, header link, print entry, neighbourhood graph node cap).
    File filters: exclude `*.secret.rq` ideas (`excludeSecretFiles`) and/or exclude paths matched by `.reqlan/.rqignore` (`excludeIgnoredFiles`); both default off so indexed ideas from those files are included unless opted out.
    Form defaults persist to [application_memory] as `export_settings.json` under `<base>/.reqlan/` (shared with other export formats; per selected base).
    Saving settings or running export writes that file; reopening the form reloads the last values for that base.
    The form builds an `ExportRequest` and calls analytical execution [html_export.html_export] (`NativeAnalysisApi.exportHtml`).
    Host options for embedded mounts surface [html_export.html_export_header_link] and [html_export.html_export_url_base].
    While export runs, the webview shows progress from the analytical pipeline (snapshot phases, then write completed/total) via `exportProgress` messages — see ["./features-export.rq".export_webview].
    @status done
    @implementation (
        ["../../packages/extension/src/analytical_submodule/export/register-export-commands.ts"]
        ["../../packages/extension/src/analytical_submodule/export/export-form-panel.ts"]
        ["../../packages/extension/src/analytical_submodule/export/export-settings.ts"]
        ["../../packages/extension/src/analytical_submodule/export/export-form-settings-types.ts"]
        ["../../packages/extension/webviews/export-form/"]
    )
    @tests (
        ["../../packages/extension/test/export-settings.test.ts"]
        ["../../packages/extension/test/extension-package.test.ts"]
        ["../../packages/extension/test/export-html-native.test.ts"]
    )
}
