
from "../vsc-primitives.rq" import code_completion


complementary_information_rendering {
    The extension should render computed information inline in the editor as complementary text.
    Complementary rendering should include resolved references and optionally indirect references behind a toggle.
    Complementary rendering should not mutate source files unless the user explicitly applies a change.
}

reference_rendering {
    Resolved references should be visually distinguishable from unresolved or broken references.
    Indirect references inferred by graph traversal should be showable via a user toggle.
    Reference kinds (dependency, incompatible with, applies to, related to) should be surfaced where declared or inferred.
}

reference_document_links {
    Bracket and wikilink idea references — both same-file and cross-file — must receive a VS Code document-link
    underline so the editor treats them identically to file-path references.
    All resolved `LocalReference` and `QualifiedReference` idea/ideaset tokens should emit links targeting the
    declaration name, regardless of whether the target lives in the same file or an imported one.
    Namespace-import alias tokens (`[alias]` → file) keep their existing file-target link.
    Implemented by ["../../../packages/language/src/reqlan-file-link-resolver.ts"]
    (`resolveIdeaReferenceLinks`, `collectFileLinks`) and
    ["../../../packages/language/src/reqlan-document-link-provider.ts"].
    @tests (
        ["../../../packages/language/test/linking.test.ts:same-file idea references produce document links"]
        ["../../../packages/language/test/linking.test.ts:cross-file imported idea references produce document links"]
        ["../../../packages/language/test/linking.test.ts:qualified reference idea token produces document link"]
    )
    @status done
}

wildcard_reference_highlighting {
    Bracket and wikilink forms of ["../../language/imports.rq".wildcard_references]
    (`["path/**/*.rq".idea_*]`, `[["path/*.rq".*_pane|label]]`) must TextMate-scope as
    `markup.underline.link.reqlan` with the path as `string.other.link.reqlan` — never as
    `comment.block.reqlan`. The grey "comment" paint happened when `#bracket-references` only
    allowed ID suffixes, so `/*` inside an unmatched path opened a block comment.
    Fixes: TextMate `#bracket-references` / wiki path patterns accept `WILDCARD_NAME` suffixes;
    `#comments` block begin rejects empty slash-star-star-slash; body rules try references before
    comments. Semantic tokens paint `WildcardReference.pathPattern` as string and `ideaPattern`
    as variable (["./features-syntax.rq".syntax_highlighting]).
    Related: ["../../language/syntax.rq".comments], ["../../language/imports.rq".wildcard_references_webview].

    @status done
    @implementation (
        ["../../../packages/language/scripts/patch-textmate.mjs"]
        ["../../../packages/language/syntaxes/reqlan.tmLanguage.json"]
        ["../../../packages/language/src/reqlan-semantic-token-provider.ts"]
    )
    @tests (
        ["../../../packages/language/test/textmate-wildcard-highlight.test.ts"]
        ["../../../packages/language/test/textmate-wildcard-highlight.test.ts:e2e: bracket wildcard path ref matches link scope and not block comment"]
        ["../../../packages/language/test/semantic-tokens-wildcard.test.ts"]
        ["../../../packages/language/test/semantic-tokens-wildcard.test.ts:e2e: WildcardReference emits string + variable tokens"]
        ["../../../packages/language/test/comment-in-string.test.ts:e2e: /**/ glob survives tokenize → parse in prose, naked quotes, and reference STRING"]
    )
}

reference_goto_definition_speed {
    Go-to-definition on any resolved idea bracket-reference must be instant — same-file refs must not
    be slower than cross-file ones, and neither should require a full document text scan at click time.
    The definition provider must use cached Langium ref objects (O(1)) for idea tokens and must not
    run character-level text scans (comment-reference scan, markdown-link regex) when the CST already
    covers the cursor position.
    Implemented by ["../../../packages/language/src/reqlan-definition-provider.ts"]
    (CST-first fast path for idea refs) and
    ["../../../packages/language/src/reqlan-markdown-links.ts"]
    (no redundant text scan when CST is available).
    @status done
}

reference_resolution_folder {
  If the reference path is a folder, the extension should render a popup with a list of files in that folder.
  The link should not try to resolve to a file if it doesn't exist.  
}


activity_bar_module {
  the extension should provide a activity bar module for the ide.
  the activity bar module should display the following information:
    - the current file
    - the current idea
    - ideas referencing the current idea/selection
    - a local graph
  see ["../module/activitybar.rq"] for more details.
}



reference_code_completion {
  references should code complete the available namespace of ideas
  this includes both ideas using hte standards idea namespace syntax, and ideas using file paths, and relative file paths.
  Cross-file candidates show import paths and may auto-insert imports:
  
  ["../language-support/features-imports.rq".import_code_completion_rendering]
  ["../language-support/features-imports.rq".import_code_completion_auto_file_import]
  Implemented by ["../../../packages/language/src/reqlan-completion-provider.ts"].
  ["../code_completion.rq"]

  @tags (
    autocompletion
    )
  @tests (
    ["../../../packages/language/test/completion.test.ts"]
  )

}

reference_code_completion_objects {
    [reference_code_completion] must offer code completion for all valid reqlan references:
    - reqlan files (`.rq`)
    - ideas and ideasets in a reqlan file after a quoted path (`["path".idea]`)
    - ideasets and ideaset members (`[ideaset.member]`)
    - code files
    - folders, including folders that do not contain `.rq` files

    Import path completion stays limited to `.rq` files.
    Anonymous file-reference paths share ranking and alias logic with import paths, but they include every file and folder target.

    @status done
    @implementation (
        ["../../../packages/language/src/reqlan-completion-provider.ts"]
        ["../../../packages/language/src/reqlan-completion-context.ts"]
        ["../../../packages/language/src/reqlan-path-completion.ts"]
    )
    @tests (
        ["../../../packages/language/test/completion.test.ts:anonymous file references complete code files, folders, and .rq files"]
        ["../../../packages/language/test/completion.test.ts:completes ideas and ideasets after a quoted file path"]
        ["../../../packages/language/test/completion.test.ts:completes ideaset members after a dotted qualifier"]
    )
}

reference_code_completion_sequencing {
  [reference_code_completion] should be offered, not alphabetically, but by distance, then alphabetically.
  Implemented by ["../../../packages/language/src/reqlan-completion-provider.ts"].
  @tests (
    ["../../../packages/language/test/completion.test.ts"]
  )
  ["../code_completion.rq".code_completion]
}

attribute_code_completion_main_descriptiption {
the main description attribute is expected to be prose, so, the dropdown shouldn't be rendered in this context.
}

attribute_code_completion_attribute_key {
the attribute key should complete based on endorsed keys and what is present in the index
i.e. after the @ symbol at the start of a line, the used attributes should be completed.
subsquently, values of the attribute key should be completed based on the values in that attribute key.
}


view_references_as_inlay_hints {
  References should be shown as inlay hints in the editor.
  This should be a toggleable setting, which should be available in the command palette.
  N-lines (configurable setting) of hints should be shown below the idea.
  Inbound lookup must stay interactive on large graphs via [inbound_inlay_index_performance].
  Implemented by ["../../../packages/language/src/reqlan-inlay-hint-provider.ts"], ["../../../packages/language/src/reqlan-inbound-reference-inlay-label.ts"], ["../../../packages/language/src/reqlan-inlay-hint-settings.ts"], and ["../../../packages/extension/src/extension/register-reference-inlay-hints.ts"].
  @status incomplete
  @tests (
    ["../../../packages/language/test/inlay-hints.test.ts"]
    ["../../../packages/language/test/inbound-referencer-index-perf.test.ts"]
  )
}



traceable_inlay_hints {
  Inlay hints should be traceable, i.e. if a user clicks a specific idea reference, it should open that idea, if a user clicks the all references hint, it should open a search webview with the idea preselected/targets prefiltered
  Implemented by ["../../../packages/language/src/reqlan-inbound-reference-inlay-label.ts"], ["../../../packages/language/src/reqlan-inlay-hint-provider.ts"], and ["../../../packages/extension/src/webview_module/register-webview.ts"].
  @status done
  @tests (
    ["../../../packages/language/test/inlay-hints.test.ts"]
  )
}

inbound_inlay_hints_whole_graph {
  Inbound references shown in [view_references_as_inlay_hints] should include referencers from the whole requirement graph across the workspace, not only ideas declared in the current file.
  Whole-graph coverage must not regress to per-idea full-index scans — see [inbound_inlay_index_performance].
  Implemented by ["../../../packages/language/src/reqlan-inbound-reference-inlay-label.ts"], ["../../../packages/language/src/reqlan-inlay-hint-provider.ts"].
  @status done
  @tests (
    ["../../../packages/language/test/inlay-hints.test.ts"]
    ["../../../packages/language/test/inbound-referencer-index-perf.test.ts"]
  )
  [view_references_as_inlay_hints]
  [traceable_inlay_hints]
  [inbound_inlay_index_performance]
  @broken
  @todo
}

inbound_inlay_index_performance {
  Computing inbound reference inlay hints for a document with many ideas must build (or reuse) a single inverse referencer index for the workspace, then look up each declaration in near-constant time.
  Must not call Langium `findAllReferences` / equivalent full-index scans once per idea (that is O(ideas × workspace refs) and freezes the editor on dense graphs).
  Implemented by ["../../../packages/language/src/reqlan-inbound-reference-inlay-label.ts"] (`buildInboundReferencerIndex`, `lookupInboundReferencers`) and ["../../../packages/language/src/reqlan-inlay-hint-provider.ts"].
  @status done
  @tests (
    ["../../../packages/language/test/inbound-referencer-index-perf.test.ts"]
    ["../../../packages/language/test/inbound-referencer-index-perf.test.ts:matches findReferences results for inbound refs"]
    ["../../../packages/language/test/inbound-referencer-index-perf.test.ts:one-pass index stays well under repeated findReferences cost"]
  )
  [view_references_as_inlay_hints]
  [inbound_inlay_hints_whole_graph]
}

code_lens_reference_types {
  References should have a ["../vsc-primitives.rq".codelens] button.
  The button should be togleable in settings.
  The button should the classification of the reference. e.g. 'open reqlan file', "open {extension} file', 'open folder', 'open idea'
  Clicking the CodeLens should open a reference card with summary stats — not navigate, because references already act as editor links.
  The card should offer open / reveal / file-selector actions when useful.
  Folders should be handled by focusing on the ide explorer, or by opening a file selector.
  Some summary stats should be shown for references - e.g. last edited, count of references, count of referencers, etc.
  Implemented by ["../../../packages/language/src/reqlan-code-lens-provider.ts"], ["../../../packages/language/src/reqlan-reference-code-lens.ts"], ["../../../packages/language/src/reqlan-code-lens-settings.ts"], ["../../../packages/extension/src/extension/register-reference-code-lens.ts"], and ["../../../packages/extension/src/extension/reference-code-lens-card.ts"].
  @status done
  @tests (
    ["../../../packages/language/test/code-lens.test.ts"]
  )
}