{
  "$schema": "./phonebook.schema.json",
  "icons": {
    "simple-icons": {
      "package": "@iconify-icons/simple-icons",
      "iconifyPrefix": "simple-icons",
      "catalog": "https://simpleicons.org/",
      "search": "https://icon-sets.iconify.design/simple-icons/"
    },
    "mdi": {
      "package": "@iconify-icons/mdi",
      "iconifyPrefix": "mdi",
      "catalog": "https://pictogrammers.com/library/mdi/",
      "search": "https://icon-sets.iconify.design/mdi/"
    }
  },
  "links": {
    "site": {
      "label": "Site",
      "href": "https://reqlan.com",
      "icon": {
        "set": "mdi",
        "name": "web"
      }
    },
    "vsc": {
      "label": "Visual Studio Marketplace",
      "href": "https://marketplace.visualstudio.com/items?itemName=reqlan.reqlan-extension",
      "icon": {
        "set": "simple-icons",
        "name": "visualstudiocode"
      }
    },
    "openvsx": {
      "label": "Open VSX",
      "href": "https://open-vsx.org/extension/reqlan/reqlan-extension",
      "icon": {
        "set": "simple-icons",
        "name": "vscodium"
      }
    },
    "github": {
      "label": "GitHub",
      "href": "https://github.com/littletuna4/reqlan",
      "icon": {
        "set": "simple-icons",
        "name": "github"
      }
    },
    "discord": {
      "label": "Discord",
      "href": "https://discord.gg/R487KDVfmA",
      "icon": {
        "set": "simple-icons",
        "name": "discord"
      }
    },
    "github-sponsors": {
      "label": "Sponsor",
      "href": "https://github.com/sponsors/littletuna4",
      "icon": {
        "set": "simple-icons",
