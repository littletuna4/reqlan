phonebook {
    Canonical project links and publishable npm package URLs live in ["./phonebook.json"].
    Modules that need contact, repo, marketplace, Discord, sponsorship, or npm package URLs should read from there instead of hardcoding values.
    Typed access is shared via ["../scripts/phonebook.ts"] for the site and extension README generator.
}

phonebook_icons {
    Icon sets and lookup URLs live under the `icons` key in ["./phonebook.json"].
    A link or package can omit `icon`. If `icon` is present, it references a set id (`simple-icons`, `mdi`, …) and slug `name` from that set's catalog.
    Search a set at its `search` URL when renaming or replacing icons.
    Surfaces render icons with Iconify via the packages listed in each set's `package` field per ["./development/core.rq".iconify_stack].
    Site registry: ["../site/src/lib/phonebook-icons.ts"] per ["./site/site.rq".icon_registry].
}

npm_packages {
    Publishable npm packages (`@reqlan/language`, `@reqlan/analytical`, `@reqlan/cli`, `@reqlan/mcp`) live under the `packages` key in ["./phonebook.json"].
    Package ids are `language`, `analytical`, `cli`, and `mcp`.
    The site Links section renders them under Packages per ["./site/site.rq".links] / ["./site/site.rq".package_icons].
    Typed helpers: `phonebookPackages`, `getPhonebookPackage` in ["../scripts/phonebook.ts"].
}

extension_readme_links {
    The extension VSIX README uses phonebook link ids `site`, `github`, `vsc`, `openvsx`, `discord`, `github-sponsors`, and `email` for site, repository, marketplace, Open VSX, Discord, sponsorship, and contact URLs.
    Generation is defined in ["./distribution/distribution.rq".extension_readme].
}

npm_package_readme_links {
    Publishable npm package READMEs (`@reqlan/language`, `@reqlan/analytical`, `@reqlan/cli`, `@reqlan/mcp`) use the same phonebook link ids as [extension_readme_links].
    Generation is defined in ["./distribution/distribution.rq".npm_package_readme].
}

activity_bar_site_link {
    The activity bar Context webview header info control opens phonebook link id `site` per ["./extension/module/activitybar.rq".info_site_link].
}

root_readme_links {
    The repository README uses phonebook link ids `site`, `github`, `vsc`, `openvsx`, `discord`, `github-sponsors`, and `email` for site, repository, marketplace, Open VSX, Discord, sponsorship, and contact URLs.
    Generation is defined in ["./distribution/distribution.rq".root_readme].
}

github_funding {
    The GitHub sponsor button is configured in ["../.github/FUNDING.yml"].
    The GitHub Sponsors username is the account in phonebook link id `github-sponsors`.
    Discord is community, not a funding platform: do not list it in FUNDING.yml.
    @status done
    @implementation (
        ["../.github/FUNDING.yml"]
    )
}

show_in_footer {
    Each entry under `links` in ["./phonebook.json"] may set `show-in-footer`.
    The property is optional. Omitted means true.
    Set `show-in-footer` to false to keep a link out of the site footer and the landing contact list.
    Packages do not have this property.
    Schema: ["./phonebook.schema.json"].
    Typed helpers: `isShownInFooter`, `phonebookFooterLinks` in ["../scripts/phonebook.ts"] and ["../site/src/lib/phonebook.ts"].
    per ["./site/site.rq".footer]
    per ["./site/site.rq".links]
    @status done
    @implementation (
        ["./phonebook.schema.json"]
        ["./phonebook.json"]
        ["../scripts/phonebook.ts"]
        ["../site/src/lib/phonebook.ts"]
        ["../site/src/components/Footer.tsx"]
        ["../site/src/content/contact.ts"]
    )
    @tests (
        ["../site/src/lib/phonebook.test.ts"]
        ["../site/src/content/contact.test.ts"]
    )
}
