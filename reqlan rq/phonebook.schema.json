{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reqlan phonebook",
  "type": "object",
  "additionalProperties": false,
  "required": ["icons", "links", "packages"],
  "properties": {
    "icons": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "iconifyPrefix", "catalog", "search"],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "iconifyPrefix": {
            "type": "string",
            "minLength": 1
          },
          "catalog": {
            "type": "string",
            "minLength": 1
          },
          "search": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/linkHref"
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/namedHref"
      }
    }
  },
  "$defs": {
    "iconRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set", "name"],
      "properties": {
        "set": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "namedHref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/iconRef"
        }
      }
    },
    "linkHref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/iconRef"
        },
        "show-in-footer": {
          "type": "boolean",
          "default": true,
          "description": "When false, do not show this link in the site footer. Omitted means true."
        }
      }
    }
  }
}
