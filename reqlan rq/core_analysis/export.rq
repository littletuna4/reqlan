
from "./core.rq" import analysis_scope

export_pipeline {
    `@reqlan/analytical` owns export execution for every format.
    Shared contract: `ExportRequest` / progress callbacks / snapshot build, then format writers.
    Hosts (extension webview, CLI) assemble an `ExportRequest` and call `NativeAnalysisApi.exportHtml` / `exportMarkdown` / `exportJson` / `exportCsv` — they do not reimplement writers.
    Formats: ["./html_export.rq".html_export], [markdown_export], [json_export], [csv_export], [pdf_export].
    Progress phases (snapshot, then write completed/total) are reported to hosts for loading UI.
    Consumed under [analysis_scope].
    Rust port of snapshot + writers: ["./rust_port.rq".export_rust].
    @status done
    @implementation (
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-export/src/snapshot.rs"]
        ["../../crates/reqlan-export/src/snapshot/filter.rs"]
        ["../../packages/analytical/src/export/types.ts"]
    )
    @tests (
        ["../../crates/reqlan-export/tests/json_export.rs:json_export_lists_persisted_ideas"]
    )
}

markdown_export {
    Markdown export writes a multi-file static site mirroring the HTML export structure: a `README.md` overview index plus per-idea `.md` pages under `ideas/`, optional per-file pages under `files/`, per-cluster pages under `clusters/`, and per-attribute pages under `attributes/`.
    Every idea link is a rich relative markdown link to its own page. Idea pages include outbound references and backlinks (inbound references) as clickable markdown links, summary, attributes, status/tags, and unresolved references.
    When per-idea pages are disabled, idea bodies are inlined in the README.
    Shared base/scope/output/name and file filters apply; HTML-only page families (graph, print) are omitted. Clusters and attribute pages are opt-in via pageOptions.
    Pipeline: `exportMarkdown` / `writeMarkdownExport` using the same snapshot builder as HTML ([export_pipeline]).
    Native engine ships the same writer (`crates/reqlan-export/src/markdown.rs`); hosts call `NativeAnalysisApi.exportMarkdown`.
    Extension UI host: ["../extension/export/export.rq".export_webview].
    @status done
    @implementation (
        ["../../packages/analytical/src/export/export-markdown.ts"]
        ["../../packages/analytical/src/export/write-markdown-export.ts"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../crates/reqlan-export/src/markdown.rs"]
    )
    @tests (
        ["../../packages/analytical/test/export-markdown.test.ts"]
        ["../../crates/reqlan-export/tests/markdown_export.rs:markdown_export_writes_rich_pages_with_links_and_backlinks"]
        ["../../crates/reqlan-export/tests/markdown_export.rs:markdown_export_inlines_ideas_when_idea_pages_disabled"]
        ["../../crates/reqlan-analytical/tests/export.rs:markdown_export_honours_cluster_and_attribute_page_flags"]
    )
}

json_export {
    JSON export writes `export.json` for the selected base: ideas (with attributes and reference lists), files, clusters, attributes, and status/tag rollups — suitable for tooling and AI consumption.
    Shared base/scope/output/name and file filters apply.
    Pipeline: `exportJson` / `writeJsonExport` ([export_pipeline]).
    Extension UI host: ["../extension/export/export.rq".export_webview].
    @status done
    @implementation (
        ["../../packages/analytical/src/export/export-json.ts"]
        ["../../packages/analytical/src/export/write-json-export.ts"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
    )
    @tests (
        ["../../packages/analytical/test/export-json-csv.test.ts"]
        ["../../crates/reqlan-export/tests/json_export.rs:json_export_lists_persisted_ideas"]
    )
}

csv_export {
    CSV export writes `ideas.csv` with tags and non-status/tag attributes flattened into columns (`attr:<key>`), plus `references.csv` for inbound/outbound/unresolved edges.
    Shared base/scope/output/name and file filters apply.
    Pipeline: `exportCsv` / `writeCsvExport` ([export_pipeline]).
    Extension UI host: ["../extension/export/export.rq".export_webview].
    @status done
    @implementation (
        ["../../packages/analytical/src/export/export-csv.ts"]
        ["../../packages/analytical/src/export/write-csv-export.ts"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
    )
    @tests (
        ["../../packages/analytical/test/export-json-csv.test.ts"]
    )
}

pdf_export {
    PDF export prepares a print-oriented HTML report from the selected base so the user can Print → Save as PDF in the browser.
    Direct PDF binary rendering is not required yet; preserve links in the printable HTML (["./html_export.rq".html_export_printable_pages]).
    PDF-specific options include file filters and print entry filename; shared base/scope/output/name apply.
    Extension UI host: ["../extension/export/export.rq".export_webview] (not a separate QuickPick chain).
    @status partial
    @implementation (
        ["../../crates/reqlan-export/src/html.rs"]
        ["../../crates/reqlan-export/src/html_template/mod.rs"]
        ["../../crates/reqlan-export/src/types.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
    )
}
