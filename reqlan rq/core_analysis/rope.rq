from "./core.rq" import analysers
from "../ai-support.rq" import cli
from "../cli/click.rq" import click
from "../extension/agent/chat-participant.rq" import mcp
from "../modelling/advanced_analysis.rq" import katz_centrality
from "../ontology.rq" import idea

roping {
    Roping is an operation that an agent can perform to quickly orientate themselves in a project.
    The idea is that, an agent can search for an idea, then, using `reqlan rope`, collect all of the higher [rope-idea-cardinality] context to a projects constitution.
    @status in-progress
}

rope {
    Rope is the command/function used for [roping],
    It is used in the [analysers] and the [cli]/[mcp].
    Surface: CLI `reqlan rope <target> [--fray <n>] [--tuning <mode>] [--graph]`, MCP tool `rope`, and AnalysisApi `rope`.
    Default `fray` is dynamic (see [dynamic-rope-tuning]); `--fray <n>` overrides it.
    Returns the chain of ideas around the target with each idea's context, respecting click session deduplication ([click-store-context-optimisation]).
    Ambiguous targets return ranked matches; no match falls through to search.
    The target may be `@root` ([rope-graph]).
    Implemented by ["../../crates/reqlan-analytical/src/rope.rs"],
    `rope` in ["../../crates/reqlan-analytical/src/api.rs"],
    `rope` in ["../../crates/reqlan-napi/src/analysis.rs"],
    `rope` in ["../../packages/analytical/src/native/native-analysis-api.ts"],
    ["../../packages/cli/src/commands/rope.ts"],
    and `handleRopeTool` in ["../../packages/mcp/src/server.ts"].
    @status done
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs"]
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_returns_cardinality_ranked_hops"]
        ["../../packages/analytical/test/rope.test.ts"]
        ["../../packages/cli/test/rope.test.ts:rope command emits kind rope with frayed candidates"]
        ["../../packages/mcp/test/server.test.ts:rope forwards target, session, fray, and tuning"]
    )
}

rope-idea-cardinality {
    rope [idea] cardinality is defined by a combination of the file position (i.e. depth), the number of ideas linked one directionally to the [idea] lower on the same branch, and the idea's position in a page, the idea's references, and the idea's [katz_centrality].
    Many cardinality signals may be combined.
    Formula: `cardinality = depth_weight * depth + branch_factor * direction_links + position_weight * page_position + reference_weight * inbound_refs + katz_weight * katz_centrality`
    Depth is the hop distance to the rope centre (farther means lower), `depth_gap = max_hops - hops`.
    Implemented as fixed constants in `cardinality_raw` in ["../../crates/reqlan-analytical/src/rope.rs"];
    default: depth_weight=0.3, branch_factor=1.5, position_weight=0.2, reference_weight=0.2, katz_weight=0.3.
    @todo make each weight configurable
    @status done
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_returns_cardinality_ranked_hops"]
        ["../../packages/analytical/test/rope.test.ts:rope API returns kind rope with cardinality candidates"]
    )
}

fray {
    Fray is like temperature. it describes how many adjacent ideas are included in a [rope] response.
    This should have a default, but user can [rope-tuning] to adjust the [fray].
    The effective fray is capped at 6; a user `--fray` is clamped the same way as a tuned one.
    @todo throw in random ideas to support incremental/incidental link discovery and deduplication
    @status done
    @tests (
        ["../../crates/reqlan-analytical/src/rope.rs:effective_fray_follows_tuning_modes"]
        ["../../packages/cli/test/rope.test.ts:rope command rejects an unknown --tuning value"]
    )
}

click-store-context-optimisation {
    [roping] should be served through the ["../ontology.rq".click], store.
    This is to prevent the retreival of the same idea into context multiple times.
    click session should be used to track visited ideas and avoid duplicates.
    When an idea is already in click session, rope should respect session context.
    When a [rope] target matches more than one idea, matches are ranked by [click] session context:
    hop distance from the session's surfaced ideas (see ["../cli/click.rq".click_session]).
    @status done
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_session_dedup_skips_already_surfaced_ideas"]
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_search_fallback_without_exact_target"]
    )
}

rope-tuning {
    Depending on model, or harness, or user input, the [fray] can be adjusted.
    Tuning modes: `default`, `focused`, `exploratory`, `deep`.
    Effective fray per [dynamic-rope-tuning] base:
    `default` = base, `focused` = 1, `exploratory` = ceil(base * 1.5), `deep` = base * 2, always clamped to the [fray] cap.
    User input `--tuning <mode>` adjusts the fray accordingly; unknown modes are an error.
    @status done
    @tests (
        ["../../crates/reqlan-analytical/src/rope.rs:effective_fray_follows_tuning_modes"]
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_focused_limits_to_adjacent_hops"]
        ["../../packages/cli/test/rope.test.ts:rope command rejects an unknown --tuning value"]
    )
}

rope-output {
    [rope] returns the ["../cli/click.rq".click_output] shape (`ClickResult`, camelCase JSON; optional fields are omitted, never null).
    Always: `sessionKey` and `candidates` (empty array when nothing qualifies).
    `kind` is `rope`, `ambiguous`, `search`, or `none` (never click's `unique`/`revisit`).
    `rope`: `target` is the centre — idea centres carry `name`, `id` (`<file>#<name>`), `fileUri`, `lineStart`, body `content`, and optional `status`; file centres carry `id` (`file:<uri>`), `name` (basename), `fileUri`, `lineStart` 0, no content. `candidates` are the chain: ordered by hop distance ascending, then cardinality descending within a hop, each row `{name, id, kind, fileUri, summary, score, hops}` where `summary` is the idea's context text (absent for file rows), `score` is normalised cardinality (top = 1, threshold 0.5, cap 24), and `hops` is BFS distance (a file centre seeds its referencing ideas at hop 1); session-surfaced ideas are dropped.
    `ambiguous`: no `target`; `candidates` ranked by click-session hop distance — `hops` 0 means already surfaced in the session, absent means unconnected; `score` = `1 / (1 + hops)`, `1/9` when unknown.
    `search`: no `target`; fuzzy `candidates` with raw fuzzy `score` and no `hops`.
    `none`: empty `candidates`, no `target`.
    Rope-kind candidate rows also carry `via`: the id of the idea the row hangs from (BFS parent; the centre id at hop 1, `file:<uri>` under a file centre). Other kinds omit `via`.
    Rope never emits click's `outbound`, `backlinks`, `commentRefs`, `siblings`, or `connected`.
    CLI text output renders the chain and colours it when stdout is a terminal: bold centre, cyan idea names, dim hops and scores; JSON and MCP output stay plain.
    @status done
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs"]
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_chain_orders_hops_then_cardinality"]
        ["../../packages/analytical/test/rope.test.ts"]
        ["../../packages/analytical/test/rope.test.ts:formatClickResult colours the rope chain"]
        ["../../packages/cli/test/rope.test.ts:rope command emits kind rope with frayed candidates"]
        ["../../packages/cli/test/rope.test.ts:rope text output prints the chain with context"]
        ["../../packages/mcp/test/server.test.ts:rope forwards target, session, fray, and tuning"]
    )
}

rope-graph {
    `--graph` on the CLI `rope` command renders the [rope-output] chain as a linearised graph in the terminal: the root at the top, then box-drawing lines (`├─`, `└─`, `│`) to each idea in chain order; the first drawn line runs from the root to the highest-cardinality idea. Each drawn node keeps its context lines, dim hops, and dim score per [rope-output].
    Root selection: the target idea is the implicit root. The target `@root` ropes the project root instead: the ideas with no inbound content references (nothing references them; ideaset membership does not count) — the project's constitution. More than one root lists ranked matches; `@root` resolves before any other target form.
    `--graph` is a CLI render mode only: JSON and MCP output carry the same `via` rows and stay plain.
    @status done
    @implementation (
        ["../../crates/reqlan-analytical/src/rope.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/cli/src/commands/rope.ts"]
    )
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_via_tracks_bfs_parents"]
        ["../../crates/reqlan-analytical/tests/rope.rs:rope_at_root_resolves_to_unreferenced_ideas"]
        ["../../packages/analytical/test/rope.test.ts:formatClickResult draws the graph chain"]
        ["../../packages/cli/test/rope.test.ts:rope --graph draws the linearised chain"]
    )
}

dynamic-rope-tuning {
    Default [rope-tuning] may be considerate of spec graph topology.
    For example, as graph gets more complex, the [fray] should be adjusted to include more adjacent ideas.
    As requested node gets close to the root, the [fray] should be adjusted to include more adjacent ideas.
    Implemented complexity metric: idea count and edge density only; base fray = 2 + edge density clamped to 0..4.
    @todo metric: centrality variance
    @todo metric: root proximity (shortest path distance from idea to any file-level ideaset)
    @status partial
    @tests (
        ["../../crates/reqlan-analytical/src/rope.rs:dynamic_base_fray_defaults_to_two"]
    )
}

algorithm {
    [rope] shall, in this order:
    1. Resolve target: idea name, `path#idea`, file basename, or indexed code file.
       More than one match returns cardinality-free candidates ranked by [click] session context; none falls through to search.
    2. Determine base [fray]: user input `--fray` when given, else the [dynamic-rope-tuning] base.
    3. Apply [rope-tuning] to reach the effective fray, clamped to the [fray] cap.
    4. Perform breadth-first search from the target up to effective-fray hops over content edges
       (ideaset membership, imports, and comment links are excluded; a file centre starts one hop out on ideas that reference it).
    5. Score each neighbour with [rope-idea-cardinality]; normalise to the top candidate and drop ideas below a 0.5 ratio.
    6. Deduplicate using the click session store: skip ideas already surfaced in the session ([click-store-context-optimisation]).
    7. Order the chain: hop distance ascending, then cardinality descending within a hop, then by name.
    8. Return compact context: the centre target plus candidate rows (names, ids, file URIs, scores, hops).
    9. Track the centre and listed ideas in the click session store.
    @status done
    @tests (
        ["../../crates/reqlan-analytical/tests/rope.rs"]
        ["../../packages/analytical/test/rope.test.ts"]
        ["../../packages/cli/test/rope.test.ts"]
    )
}
