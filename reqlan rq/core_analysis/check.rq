check_skip_targets {
    [check] omits an issue when the missing [reference] target matches a skip glob.
    The analyser function `check_references` takes `skip_targets`: a list of globs.
    Match uses the same path glob rules as `--glob`. Match is against the issue `label` (the missing target), not the source file.
    An empty skip glob has no effect.
    Use this when a referenced file is not in git and you name the skip glob.
    For all Git ignore rules, use [check_skip_gitignored_targets].
    CLI: repeatable `--skip-target <glob>` (["../cli/cli_package.rq".commands]).
    API: `AnalysisApi.check({ skipTargets })`.
    Related: [check] [check_skip_gitignored_targets] [check_meta_implementation]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/mod.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/cli/src/commands/check.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_skips_targets_that_match_skip_globs"]
        ["../../crates/reqlan-index/tests/broken_references.rs:path_glob_matches_cursor_skip_glob"]
        ["../../crates/reqlan-analytical/tests/broken_references.rs:analysis_api_check_honours_skip_targets"]
        ["../../packages/cli/test/check.test.ts:honours skip-target globs"]
    )
}

check_skip_gitignored_targets {
    [check] omits a file [reference] issue when Git ignore rules ignore the missing target.
    The analyser function `check_references` takes `skip_gitignored_targets` (default false).
    Match uses the workspace ["../../.gitignore"] and nested `.gitignore` files on the target path.
    Match uses the resolved path from the workspace root, not the authored path in the source file.
    Idea references, comment references, and missing imported idea names stay in the issue list.
    Missing import paths follow the same skip as file references ([check_unresolved_imports]).
    Use this when a referenced file is build output or editor config that git does not store.
    Examples: `.cursor/` for ["../extension/agent/chat-participant.rq".mcp], and `packages/extension/media/webviews/` for ["../extension/host/onboarding/page-thanks-for-installing.rq".installation_event].
    CLI: `--skip-gitignored-targets` (["../cli/cli_package.rq".commands]).
    API: `AnalysisApi.check({ skipGitignoredTargets })`.
    CI: ["../../.github/workflows/ci.yml"] and ["../../azure-pipelines.yml"] pass `--skip-gitignored-targets` because a CI checkout does not contain gitignored files ([check_meta_implementation]).
    Related: [check] [check_skip_targets] [check_unresolved_imports] [check_meta_implementation]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/mod.rs"]
        ["../../crates/reqlan-index/src/ignore.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/cli/src/commands/check.ts"]
        ["../../.github/workflows/ci.yml"]
        ["../../azure-pipelines.yml"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_skips_gitignored_file_targets"]
        ["../../crates/reqlan-index/src/ignore.rs:workspace_gitignore_matches_root_and_nested_rules"]
        ["../../crates/reqlan-analytical/tests/broken_references.rs:analysis_api_check_honours_skip_gitignored_targets"]
        ["../../packages/cli/test/check.test.ts:honours skip-gitignored-targets"]
        ["../../packages/analytical/test/release-ci-gate.test.ts:CI check skips gitignored targets"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_skips_gitignored_import_paths"]
    )
}

check_qualified_missing_file {
    A qualified [reference] names a file and an idea. Example: `["../../../../my/non-existentfile.ts".term]`.
    [check] reports an error when that file is not on disk.
    The issue kind is `file_reference`. The label is the resolved file path.
    A qualified reference to a file that exists is not this error.
    A same-file idea reference is not this error.
    The editor already underlines this target.
    Related: [check] [check_qualified_missing_idea] ["../language/syntax.rq".reference_file] ["../extension/language/syntax/features-syntax-highlighting.rq".unresolved_reference_diagnostics]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/qualified.rs"]
        ["../../crates/reqlan-index/src/path_resolve.rs"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_reports_qualified_reference_to_a_missing_file"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_reports_qualified_reference_to_a_missing_rq_file"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_accepts_qualified_reference_when_the_file_exists"]
    )
}

check_qualified_missing_idea {
    A qualified [reference] names a file and an idea. Example: `["../extension/index-host/graph-analysers.rq".not_an_idea]`.
    The same rule applies to a namespace alias: `[alias.idea]` ([import_namespace]).
    [check] reports an error when that file is an `.rq` file, the file does not declare the idea, and the file does not bind that name as an import alias.
    The issue kind is `references`. The label is the missing idea name.
    A path with no extension means `.rq` first ([implicit_file_extension]).
    A qualified reference to an idea that the `.rq` file declares is not this error.
    A qualified reference to an import alias bound in that file is not this error.
    A namespace import binds its `as` name.
    A from-import or qualified import binds its `as` name, or the idea name when `as` is absent.
    A from-import of an import alias stays [check_unresolved_imports]. The alias is not an idea.
    A qualified reference to a code file is not this error. That form uses [check_qualified_missing_file].
    A missing file stays [check_qualified_missing_file]. [check] does not also report a missing idea for that file.
    [comment_reference_ignore] suppresses this error.
    Related: [check] [check_qualified_missing_file] ["../language/syntax.rq".reference_qualified]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/qualified.rs"]
        ["../../crates/reqlan-index/src/check/index.rs"]
        ["../../crates/reqlan-parse/src/ast.rs"]
        ["../../crates/reqlan-lsp/src/analysis.rs"]
        ["../../crates/reqlan-lsp/src/session.rs"]
        ["../../packages/language/src/reqlan-neighbor-parse.ts"]
        ["../../packages/language/src/reqlan-outbound-presentation.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_reports_qualified_reference_to_a_missing_idea"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_reports_namespace_qualified_reference_to_a_missing_idea"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_skips_qualified_missing_idea_on_rq_ignore_error"]
        ["../../crates/reqlan-lsp/tests/parity.rs:missing_qualified_rq_file_reports_unresolved_idea"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_accepts_qualified_reference_when_the_file_exists"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_reports_qualified_reference_to_a_missing_file"]
        ["../../crates/reqlan-index/tests/golden_corpus.rs:qualified_reference_to_an_import_alias_is_not_a_missing_idea"]
        ["../../crates/reqlan-lsp/tests/parity.rs:golden_corpus_import_alias_is_not_an_unresolved_idea"]
    )
}

check_unused_imports {
    `check_references` reports an unused import when the import path resolves, the named idea exists, and the bound name produced by the import specifier or import alias is never referenced in the file body (no `Local` reference to the bound name, no `Qualified` reference with qualifier = alias, no `IdeaSet` member with that name).
    Issue kind is `unused_import`. Severity defaults to `warning` (controlled by `unusedImports`: `"warn"` | `"error"` | `"off"`, default `"warn"`).
    CLI flag: `--unused-imports <warn|error|off>`. Per-file `unusedImports` is read from `.reqlan/config.json` for the source file's applying base.
    Suppressed when the preceding line is `//rq-ignore-error`.
    Related: [check], [check_unresolved_imports], ["../language/imports.rq".unused_imports], ["../extension/host/configuration.rq".configuration_import_roots].

    @status in-progress
    @implementation (
        ["../../packages/cli/src/commands/check.ts"]
        ["../../packages/mcp/src/server.ts"]
        ["../../crates/reqlan-index/src/check/imports.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
    )
    @tests (
        ["../../packages/cli/test/check.test.ts:unused-imports reports unused specifiers"]
