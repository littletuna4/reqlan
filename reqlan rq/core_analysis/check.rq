check_no_cache {
    [check] accepts `--no-cache`.
    The flag bypasses the on-disk ideas-index SQLite (`<base>/.reqlan/ideas-index.sqlite`).
    This is not the soft mtime skip used by indexer sync (["../indexer/indexer.rq".nonblocking_index]).
    With the flag, the process does not open, read, or write that SQLite file.
    [check] builds an in-memory ideas index from source files on disk and reports issues from that view.
    Default [check] may still open and soft-sync the on-disk ideas index.
    `--json`, `--pipe`, `--glob`, skip flags, wildcard flags, and [check_verbose] still apply.
    CLI: ["../cli/cli_package.rq".commands].
    API open: `AnalysisRuntime::open_uncached` / `openAnalysisApi({ noCache: true })`.
    Related: [check] [check_verbose] ["../extension/index-host/index.rq".application_memory] ["../indexer/sqlite-schema.rq".ideas_index_sqlite]
    @status done
    @implementation (
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/cli/src/runtime.ts"]
        ["../../packages/cli/src/commands/check.ts"]
    )
    @tests (
        ["../../crates/reqlan-analytical/tests/broken_references.rs:analysis_api_check_no_cache_skips_ideas_index_sqlite"]
        ["../../packages/cli/test/check.test.ts:--no-cache does not open or write ideas-index.sqlite"]
    )
}

check_verbose {
    [check] accepts `-v`, `-vv`, and `-vvv`.
    These flags write sync diagnostics to stderr.
    They do not change stdout, `--json`, or `--pipe` issue output.
    Default (no flag): stderr stays quiet except command errors.
    `-v`: index mode (`disk` or `memory` from [check_no_cache]), sync totals (indexed, skipped_mtime, errors, processed/total), and issue count.
    `-vv`: also one stderr line per sync file action (`indexed`, `skipped_mtime`, `error`, `skipped`).
    `-vvv`: also appends skip and error detail on those file lines.
    With [check_no_cache], file lines come from the from-source index pass.
    That pass must not report process-local soft mtime skips against the in-memory rows just written.
    Default disk check may still report `skipped_mtime` against the on-disk ideas index.
    API: `openAnalysisApi({ recordFileEvents })` then `checkReport` / `AnalysisRuntime::check_report`.
    CLI: ["../cli/cli_package.rq".commands].
    Related: [check] [check_no_cache] ["../indexer/indexer.rq".nonblocking_index]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/sync.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/analytical/src/native/open-analysis-api.ts"]
        ["../../packages/cli/src/runtime.ts"]
        ["../../packages/cli/src/format-check-verbose.ts"]
        ["../../packages/cli/src/commands/check.ts"]
    )
    @tests (
        ["../../packages/cli/test/check.test.ts:-v writes index mode and sync totals to stderr"]
        ["../../packages/cli/test/check.test.ts:-vv lists per-file sync actions on stderr"]
        ["../../packages/cli/test/check.test.ts:--no-cache -vv does not report process-local mtime skips"]
        ["../../packages/cli/test/check.test.ts:-vvv includes skip detail on stderr"]
        ["../../packages/cli/test/format-check-verbose.test.ts:formats verbosity levels"]
    )
}

check_glob_patterns {
    [check] accepts more than one `--glob` pattern.
    Repeat `--glob` for each pattern.
    A file is in the recursive scan when it matches any glob.
    One `--glob` selects the same files as one path glob.
    A reference target that matches no glob is still checked.
    That target must resolve.
    [check] does not walk a directory that matches no glob.
    A positional path can name a file outside the globs.
    [check] checks that file.
    A positional path that is a directory outside the globs is not walked.
    An empty `--glob` value is an error.
    API: `AnalysisApi.check({ pathGlobs, paths })`.
    CLI: ["../cli/cli_package.rq".commands].
    MCP: ["../extension/agent/skills-and-mcp.rq".mcp_check].
    Related: [check]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/mod.rs"]
        ["../../crates/reqlan-index/src/sync.rs"]
        ["../../crates/reqlan-index/src/extract.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
        ["../../crates/reqlan-napi/src/lib.rs"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../packages/cli/src/commands/check.ts"]
        ["../../packages/mcp/src/server.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_two_globs_report_an_outside_target_and_skip_outside_directories"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_includes_an_explicit_file_outside_the_globs"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_rejects_an_empty_path_glob"]
        ["../../crates/reqlan-analytical/tests/broken_references.rs:analysis_api_check_honours_multiple_globs_and_extra_paths"]
        ["../../packages/cli/test/check.test.ts:checks files from two globs and one file outside them"]
        ["../../packages/cli/test/check.test.ts:does not recurse into a directory outside the globs"]
        ["../../packages/cli/test/check.test.ts:rejects an empty glob"]
        ["../../packages/mcp/test/server.test.ts:check accepts one glob or a list of globs"]
    )
}

check_order_by_target {
    [check] returns issues ordered by the missing [reference] target, not by the source file.
    Rows that share the same missing idea, comment target, file path, or import target stay together so you can see every site that points at one missing thing.
    Inside a target group, order by kind, then source file, then line.
    JSON and pipe keep a flat list in that order. Terminal output uses one heading per missing target.
    Related: [check] ["../cli/cli_package.rq".commands]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/mod.rs"]
        ["../../packages/cli/src/format-broken-refs.ts"]
        ["../../packages/cli/src/commands/check.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_orders_issues_by_missing_target"]
        ["../../packages/cli/test/check.test.ts:orders json rows by missing target"]
        ["../../packages/cli/test/format-broken-refs.test.ts:groups rows that share a missing target under one heading"]
    )
}

check_wildcard_sparse {
    A ["../reference_types.rq".wildcard_reference] is for many matches.
    [check] recounts each wildcard against the full idea catalog, not the stored edges, so files that the indexer visited first still get the true match count.
    How 0-match and 1-match rows are handled is controlled by [check_wildcard_zero] and [check_wildcard_one] (both default `warn`).
    Ignore a site with [comment_reference_ignore].
    The language server already warns when a wildcard matches nothing (["../language/imports.rq".wildcard_references]); it also warns when the match count is 1.
    Related: [check] ["../language/imports.rq".wildcard_references]
    @status done
    @implementation (
        ["../../crates/reqlan-index/src/check/wildcards.rs"]
        ["../../crates/reqlan-index/src/extract.rs"]
        ["../../packages/cli/src/format-broken-refs.ts"]
        ["../../packages/language/src/reqlan-validator.ts"]
    )
    @tests (
        ["../../crates/reqlan-index/tests/broken_references.rs:check_warns_when_a_wildcard_matches_zero_or_one_idea"]
        ["../../crates/reqlan-index/tests/broken_references.rs:check_skips_sparse_wildcard_warning_on_rq_ignore_error"]
        ["../../packages/cli/test/check.test.ts:warns on wildcards with 0 or 1 match"]
        ["../../packages/cli/test/format-broken-refs.test.ts:marks wildcard sparse rows as warnings"]
        ["../../packages/language/test/wildcard-references.test.ts:warns when wildcard matches nothing"]
        ["../../packages/language/test/wildcard-references.test.ts:warns when wildcard matches only one idea"]
    )
}

check_wildcard_zero {
    `check_references` flag `wildcard_zero` (default `warn`) controls a ["../reference_types.rq".wildcard_reference] that matches 0 ideas.
    0 matches means the pattern hits nothing.
    `warn` — emit the row with severity `warning` and match count 0.
    `error` — emit the row with severity `error` and match count 0.
    `off` — omit the row.
    CLI: `--wildcard-zero <warn|error|off>` (["../cli/cli_package.rq".commands]).
    API: `AnalysisApi.check({ wildcardZero })`.
    Related: [check] [check_wildcard_sparse] [check_wildcard_one]
