from "../modelling/advanced_analysis.rq" import pagerank, search_with_context, idea_graph_distance
from "../extension/module/context-scope-v2.rq" import context_scope_v2
import "../../packages/analytical/src/analysis/fuzzy-search.ts" as fuzzy_search_impl
import "../../packages/analytical/src/analysis/fuzzy-search-analyser.ts" as fuzzy_search_analyser
import "../../packages/analytical/src/analysis/semantic-search-analyser.ts" as semantic_search_analyser
import "../../packages/analytical/src/analysis/contextual-search.ts" as contextual_search_impl
import "../../packages/cli/src/commands/search.ts" as search_cli

search {
    Search over the requirement graph — find ideas by name, body, tags, and related signals.
    Surfaces: [fuzzy_search], [contextual_search], [semantic_search].
    Consumed by CLI `reqlan search`, MCP/chat tools, Ideas Summary, and the activity-bar search pane.
    Rust ranking engine: ["./rust_port.rq".search_rust].
    @todo flesh out shared search UX / ranking contract across surfaces
}

fuzzy_search {
    Quick ranked idea search by name, summary, and tags.
    Separator and word-order behaviour: [fuzzy_search_whitespace].
    Also supports prefix, substring, and character-subsequence (fuzzy) ranking.
    Skips ideaset container rows; empty query returns all non-ideaset ideas (callers may require a non-empty query).
    Implementation: [fuzzy_search_impl] / [fuzzy_search_analyser] (`fuzzy_search` analyser id).
    @tests (
        ["../../packages/analytical/test/fuzzy-search.test.ts"]
    )
    @status done
}

fuzzy_search_whitespace {
    Matching treats `_`, `-`, `.` / `...` / `…`, and whitespace as interchangeable separators
    so queries like `cli package`, `cli_package`, and `cli-package` hit the same idea.
    Prefers query word order, but still matches when words are reordered or when intermediate name words are missing
    (e.g. `package cli` → `cli_package`, `search actions` → `search_code_actions`).
    Extends [fuzzy_search]; implementation [fuzzy_search_impl].
    @tests (
        ["../../packages/analytical/test/fuzzy-search.test.ts"]
        ["../../packages/analytical/test/fuzzy-search.test.ts:matches across separator substitutions"]
        ["../../packages/analytical/test/fuzzy-search.test.ts:matches reordered and partial word queries"]
    )
    @status done
}

contextual_search {
    Search string plus an optional context list of relative `.rq` paths, `path#idea` refs, or bare idea names.
    Runs [semantic_search], then re-ranks with min undirected hop distance from any resolved context idea
    and exponential decay ([idea_graph_distance]): `finalScore = textScore * 2^(-minHop)` (unreachable floor = 8 hops).
    Surfaces: `AnalysisApi.searchRequirements(..., { context })`, CLI `reqlan search --context` ([search_cli]),
    and the shared helper [contextual_search_impl].
    Implements [search_with_context]. PageRank ([pagerank]) and full [context_scope_v2] ingestion remain future work.
    Complements [fuzzy_search] when neighbourhood / context should bias ranking.
    @tests (
        ["../../packages/analytical/test/contextual-search.test.ts"]
        ["../../packages/analytical/test/context-signals.test.ts"]
    )
    @status done
}

semantic_search {
    Broader token / edge-label search over candidates ([semantic_search_analyser]).
    Prefer [fuzzy_search] for fast name-oriented lookup with separator-insensitive matching.
    @todo
}
