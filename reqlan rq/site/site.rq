import "../distribution/distribution.rq" as distribution_reqs
import "../phonebook.rq" as phonebook_reqs
import "../development/core.rq" as development_core
import "../core_analysis/html_export.rq" as html_export
import "../cli/cli_package.rq" as cli_package
import "../../site/src/components/Contact.tsx" as contact_component
import "../../site/src/components/Hero.tsx" as hero_component
import "../../site/src/components/PhonebookIcon.tsx" as phonebook_icon_component
import "../../site/src/lib/phonebook-icons.ts" as phonebook_icon_registry

site {
    the /site folder contains a static Next.js App Router landing page for reqlan.
    should align with [brand]
}

simple_lightweight_and_static {
    must be fully statically exported for GitHub Pages.
    All routes, including showcase detail pages, are generated at build time.
    The deploy workflow must upload only static HTML, JS, and assets from site/out.
    Build also embeds the workspace requirement graph under `/spec` per [spec_html_export].
}

spec_html_export {
    The site static build exports the workspace requirement graph (excluding `*.secret.rq`) under `out/spec/` via `reqlan export`.
    It must pass [html_export.html_export_url_base] for `/spec` (honouring `SITE_BASE_PATH`, e.g. `/reqlan/spec` in production) so `/spec` loads with or without a trailing slash.
    It must pass [html_export.html_export_header_link] pointing at the marketing site home so readers can leave the embedded spec and return to the parent site.
    Embedded `/spec` graph pages inherit [html_export.html_export_graph_background_load] so large workspace graphs do not freeze the page while settling.
    Pipeline: ["../../site/scripts/build-static.mts"] → ["../../site/scripts/export-spec.mts"] → ["../../site/scripts/verify-static-export.mts"].
    Host options come from [html_export.html_export] / CLI [cli_package.commands], including native CLI export via ["../core_analysis/rust_port.rq".native_bridge].
    @status done
    @implementation (
        ["../../site/scripts/export-spec.mts"]
        ["../../site/scripts/verify-static-export.mts"]
        ["../../site/scripts/build-static.mts"]
        ["../../packages/analytical/src/native/native-analysis-api.ts"]
        ["../../crates/reqlan-analytical/src/types.rs"]
        ["../../crates/reqlan-analytical/src/api.rs"]
    )
    @tests (
        ["../../site/scripts/verify-static-export.mts"]
        ["../../packages/analytical/test/native-export-request.test.ts"]
        ["../../crates/reqlan-analytical/tests/export.rs:html_export_honours_graph_page_url_base_and_header_link"]
    )
}

workflow {
    Site deployment runs when an `site/v*` tag is pushed. 
    Tags are created automatically on main by the release workflow per [distribution_reqs.deployment_flow].
    The site workflow does not deploy on ordinary commits.
    per [distribution_reqs.site_distribution]
}

routes {
    Marketing routes are statically generated App Router pages under ["../../site/src/app"].
    Home `/` hosts landing sections; other top-level pages include quickstart per [quickstart_page], tutorials, showcase, FAQ, and the embedded `/spec` export.
    per [sidebar_nav]
    per [faq_page]
    per [quickstart_page]
}

components {
    - sidebar per [sidebar_nav]
    - footer
    - hero
    - sticky page nav graph (landing)
    - links/contact
    - showcases
    - tutorials per [tutorials_section]
    - FAQ per [faq_page]
    - content
        - motivation
        - syntax
        - example
        - roadmap per [roadmap_section]
    - CTA:
        - download the extension
        per [cta_icon]
    - 404 page (just something silly / a redirect)
}

sidebar_nav {
    The site sidebar is a hierarchical page nav, not a flat list of mixed anchors and routes.
    Top-level entries are pages (or the home hub). Same-page section anchors nest as children under their parent page.
    Children render only while the visitor is on that parent page — off-page section lists stay collapsed so the sidebar reflects the current route.
    Until pathname is known after mount, children stay closed (do not default to Home) so static HTML / hydration does not flash a mismatched hierarchy.
    The active page uses `aria-current="page"`; the in-view same-page section uses `aria-current="location"` when known.
    Nav model and labels live in site content per [copy]; the Sidebar client reads pathname (and hash/section when on home) to decide expansion and current markers.
    FAQ is a top-level page entry per [faq_page].
    @status done
    @implementation (
        ["../../site/src/components/Sidebar.tsx"]
        ["../../site/src/components/Sidebar.module.css"]
        ["../../site/src/content/site.ts"]
    )
}

faq_page {
    The site exposes `/faq/` as a statically generated page answering a short set of common questions.
    Copy stays minimal per [copy]. Support answers point at phonebook surfaces (GitHub stars, marketplace stars, issues/contribution, email for sponsorship or donation) rather than inventing URLs.
    Required topics:
    - how reqlan supports token efficiency
    - whether reqlan is the de facto standard for efficient developer-centric context management and semantic mapping
    - when to use reqlan
    - how to support reqlan (GitHub stars, sponsorship, VS Marketplace stars, donation, contribution, bug reporting)
    Sidebar nests FAQ question anchors as same-page children per [sidebar_nav].
    Landing nav graph includes FAQ as a page node.
    @status done
    @implementation (
        ["../../site/src/app/faq/page.tsx"]
        ["../../site/src/views/FaqPage.tsx"]
        ["../../site/src/views/faq.module.css"]
        ["../../site/src/content/site.ts"]
        ["../../site/src/components/Sidebar.tsx"]
        ["../../site/src/components/NavGraph.tsx"]
    )
}

quickstart_page {
    The site exposes `/quickstart/` as the install / get-started page.
    After install steps, it links onward to Tutorials, Showcases, and FAQ so visitors can continue without returning to the home nav.
    Related link copy lives in ["../../site/src/content/quickstart.ts"] per [copy].
    @status done
    @implementation (
        ["../../site/src/app/quickstart/page.tsx"]
        ["../../site/src/views/QuickstartPage.tsx"]
        ["../../site/src/components/QuickstartClient.tsx"]
        ["../../site/src/components/QuickstartClient.module.css"]
        ["../../site/src/content/quickstart.ts"]
    )
}

roadmap_section {
    Landing page section `#roadmap` after example and before links.
    Compact vertical scaled-center carousel (snap + distance-based scale/opacity peeks).
    Flat Now / Next / Later items — one focused at a time; neighbours peek smaller.
    Copy lives in site content (per [copy]); nav and sticky page graph include the section.
    Keep the list honest and thin — no fake dates, no wall of tickets.
    @status done
    @implementation (
        ["../../site/src/components/Roadmap.tsx"]
        ["../../site/src/content/site.ts"]
        ["../../site/src/views/HomePage.tsx"]
        ["../../site/src/components/NavGraph.tsx"]
    )
    @todo refresh items when product priorities shift
}

tutorials_section {
    The site exposes `/tutorials` and `/tutorials/[slug]/` as statically generated pages.
    Catalog and deck ids come from authored ["../../presentations/manifest.jsonc"].
    Each detail page embeds the Reveal player iframe at `/presentations/player/?deck=<id>` using [assets] / SITE_BASE_PATH-aware `sitePath`.
    Each detail page hosts a unified transport chrome (`<<` `<` steps `>` `>>`) that drives slide nav in the embedded player via postMessage, plus lesson jumps.
    Location hierarchy chrome: [tutorial_location_crumb].
    Blurb and try-this live on the catalog and inside the slides, not as page chrome.
    The player is an App Router page ([presentation_player_route]) so it static-exports under `trailingSlash` without colliding with `public/` HTML.
    Sync ([sync_presentations]) converts authored deck/catalog JSONC under ["../../presentations/"] into runtime JSON under `public/presentations/`, and copies assets plus vendored Reveal.js (player shell excluded).
    @status done
    @implementation (
        ["../../site/src/app/tutorials/page.tsx"]
        ["../../site/src/app/tutorials/[slug]/page.tsx"]
        ["../../site/src/app/presentations/player/page.tsx"]
        ["../../site/src/content/tutorials.ts"]
        ["../../site/src/components/TutorialPlayerShell.tsx"]
        ["../../site/src/components/PresentationPlayer.tsx"]
        ["../../site/scripts/sync-presentations.mts"]
        ["../../site/src/lib/parse-jsonc.ts"]
    )
}

tutorial_location_crumb {
    Tutorial detail chrome shows a compact location trail: catalog → course → lesson → slide.
    Hierarchy must be obvious without a wide single-line title dump.
    Layout: each tier is a stacked chip — role (and optional completion control) on the top row;
    title / index value muted underneath. Titles colour up on hover, focus-within, or when the peer menu is open.
    **Folder navigation:** each tier acts like a path segment / folder. Hover or focus reveals a peer menu
    for that level of the tree so the user can jump without using the transport row:
    - catalog → courses (enter first lesson of the chosen course, or the catalog index)
    - course → peer courses
    - lesson → peer lessons in the active course
    - slide → peer slides in the active lesson (updates the embedded player / `?slide=`)
    Current peer is marked; menus stay keyboard-reachable via focus-within.
    **Sizing:** the crumb container grows to fit text; wrap before truncating. Ellipsis only as a last resort
    on very narrow viewports — do not cap chip width so aggressively that titles ellipsize while space remains.
    Course deep-links also exist at `/tutorials/#course-<series>`; catalog at `/tutorials/`.
    Slide shows `n/total` and updates live with the embedded player.
    Completion toggles stay on the role row.
    The crumb lesson tier always shows the **current** lesson only — it must not share hover/preview
    state with the transport lesson step dots. Step-dot hover may preview a title near the dots, never in the crumb.
    @status done
    @implementation (
        ["../../site/src/components/TutorialPlayerShell.tsx"]
        ["../../site/src/components/TutorialPlayerShell.module.css"]
    )
}

sync_presentations {
    `scripts/sync-presentations.mts` reads authored `*.jsonc` decks and `manifest.jsonc`, emits comment-free `*.json` for the static player, and syncs assets/vendor into `public/presentations/`.
    @status done
    @implementation (
        ["../../site/scripts/sync-presentations.mts"]
        ["../../site/src/lib/parse-jsonc.ts"]
    )
}

presentation_player_route {
    `/presentations/player/` is a statically exported Next page that loads runtime deck JSON from `/presentations/decks/` and Reveal from `/presentations/vendor/reveal.js/`.
    Runtime JSON is generated from authored JSONC by [sync_presentations].
    It must not use SiteShell; it is iframe-hosted by tutorial detail pages.
    Do not place `public/presentations/player/index.html` — that path is owned by the App Router export.
    @status done
}

code_block_styling {
    Code blocks should be styled per language as a function of a classname; or by using an appropriate lightweight external dependency.
    .rq, .ts, .md, and .py should be supported for code sections.
    If using a dependency, it should parse at build, not in the browser.
}

logo {
    - there is a logo in the sidebar.
}

assets {
    this site is published in in gh pages at the "/reqlan" path. Any assets in the /public folder should be referenced as "/reqlan/assets/...".
    Embedded spec export hrefs follow the same base via [spec_html_export] / [html_export.html_export_url_base].
}

brand {
    must be aligned with ["../brand.rq"]
}

images {
    The source logo is in the /public folder. A sharp dev script is used to generate pngs and favicons etc which should be executed if the svg source logo changes.
}

copy {
    - In a ts object decoupled from the actual layout/styling.
    - copy should be really super minimal and concise if at all. (show don't tell)
}

links {
    per [phonebook_reqs.phonebook]
    per [phonebook_reqs.npm_packages]
    Contact shows phonebook `links` then a Packages subsection for phonebook `packages`.
    per [link_icons]
    per [package_icons]
}

// Site icon rendering for phonebook links and CTAs — policy in [development_core.iconify_stack]

icon_registry {
    [phonebook_icon_registry] maps phonebook icon keys to bundled Iconify data for the site.
    Every link and package icon in the phonebook must have a matching registry entry; the module throws at startup if one is missing.
    When adding or changing an icon in ["../phonebook.json"], update the registry import for that slug.
    per [development_core.iconify_stack]
    per [development_core.phonebook_icon_keys]
}

phonebook_icon_component {
    [phonebook_icon_component] is the site's single render entry point for phonebook icons (`@iconify/react`).
    It accepts a phonebook `icon` ref and renders an inline SVG with `aria-hidden`.
    Default sizing uses the `.phonebook-icon` class in ["../../site/src/styles/globals.css"].
    Must remain compatible with static export per [simple_lightweight_and_static].
    per [development_core.iconify_stack]
}

link_icons {
    The contact link row in [contact_component] renders an icon beside each phonebook link label.
    per [links]
    per [development_core.current_link_icons]
}

package_icons {
    The contact Packages row in [contact_component] renders an icon beside each phonebook package label.
    Package entries come from ["../phonebook.json"].packages per [phonebook_reqs.npm_packages].
    per [links]
    per [development_core.current_link_icons]
}

cta_icon {
    The hero install control is a single "Install" menu button that opens an editor/download chooser (Cursor, VS Code, Open VSX, Download VSIX) — it must not assume the user's editor or pre-select one silently.
    Each menu row shows the target's icon beside its full label; icons resolve through [phonebook_icon_registry] via the quickstart icon set/name refs in ["../../site/src/content/install-actions.ts"].
    per [components]
    per [development_core.iconify_stack]
}

styling_architecture {
    styling should be handled primarily at the compoenent level with co-located css module files that are imported in the react components.
}

// Showcase content plan for the marketing site.
// Objective: demonstrate, with precision and taste, the highest-value edges
// of the reqlan toolset — with examples in different domains.

showcase {
    Every showcase demonstrates a mechanism, not a metaphor.
    Domain problem, the .rq that binds it, the real artifact in another language
    it binds to, and the thing the tooling hands back.

    Content is authored in TS objects per [showcase_module], not generated from this file at runtime.
    This file is the source of truth for intent, ordering, and editorial rules.

    @implementation (
        ["@/site/src/content/showcases.ts"]
        ["@/site/src/app/showcase"]
        ["@/site/src/views/ShowcaseListPage.tsx"]
        ["@/site/src/views/ShowcaseDetailPage.tsx"]
    )
    @status done
    @tags (
        site
        showcase
        content
    )
}

// --- thesis & editorial rules -------------------------------------------------

showcase_thesis {
    Current showcases demonstrate the syntax, not the toolset.
    A reader who finishes them thinks: you can write sentences in curly brackets.
    Nothing shows what you get back — no query and answer, no diagnostic, no graph, no round trip.

    The upgrade thesis:
    every showcase demonstrates one mechanism against a real domain problem.
    Code in, artifact out. No showcase ships without a payoff block.
}

showcase_problems {
    Three concrete failures of the current set:

    Invalid reqlan.
    Samples use illegal attribute forms (colon-list tags, pipe-scalar plans,
    nested reference objects) that do not parse against the langium grammar.
    For a language project, shipping invalid samples on the marketing site is an own-goal.
    ```rq
    // these do NOT parse — do not ship
    @tags: (iec-61131, critical)
    @plan: |
      1. step
    @references: ({ [x] })
    ```

    Prose dressed as semantics.
    A file ref followed by the word "implements" and an idea ref reads like a typed
    relation, but "implements" is body text. Reqlan has five edge kinds
    (references, wildcard_reference, file_reference, ideaset_member, import, comment_link)
    and none are user-declared. We imply a feature that does not exist while
    hiding the ones that do.

    Vapor features.
    Graph showcase tells people to run Reqlan: Export JSON, which is not registered.
    The docs-attribute page is built around an attribute with no special tooling.
}

every_rq_block_must_parse {
    Every language-"rq" block in showcases.ts must parse against the langium grammar.
    Prefer enforcement via a build step that runs the real parser over content.
    aligns with [phase_1_parse_gate]
}

every_showcase_ends_in_a_payoff {
    A diagnostic, a query response, a coverage report, or a graph.
    If there is no tooling output, it is not a showcase.
}

one_worked_example_per_page {
    Consistent identifiers across every block on a page.
    The reader should trace one name from requirement to source to test to
    search result without re-orienting.
}

diagrams_are_never_dressed_as_code {
    ASCII arrow diagrams must not sit inside language-"rq" blocks.
    They get their own visually distinct block kind.
    aligns with [showcase_module]
}

showcase_rules {
    Four editorial rules. Enforced in content and, where possible, at build time.
    See [every_rq_block_must_parse], [every_showcase_ends_in_a_payoff],
    [one_worked_example_per_page], [diagrams_are_never_dressed_as_code].

    @tags (
        editorial
        rules
    )
}

showcase_rules_set (
    every_rq_block_must_parse,
    every_showcase_ends_in_a_payoff,
    one_worked_example_per_page,
    diagrams_are_never_dressed_as_code
)

// --- features worth demonstrating --------------------------------------------

features_tier_1 {
    The reasons to adopt. All verified as shipping today.

    @subreqs (
        sub_file_binding {
            Symbol refs ["auth.ts".login], line ranges ["adc.cL#41-58"],
            and test-name anchors ["x.test.ts:rejects expired token"].
            Requirements attach to code at symbol granularity, in any language.
        }
        bidirectional_comment_links {
            rq-comment refs in TS, Python, C, ST, etc.
            Code points back, with working document links.
        }
        refs_break_loudly {
            Unresolved references are error diagnostics with quick-fix code actions.
            File moves prompt to rewrite every inbound ref.
            The anti-rot argument — currently demonstrated nowhere.
        }
        mcp_as_shaped_context {
            search_requirements, file_context, local_graph, summarize_subtree.
            Hand an agent six ideas and their edges instead of forty files.
        }
    )
    @tags (
        features
        tier-1
    )
}

features_tier_2 {
    The depth. Also shipping.

    @subreqs (
        imports_aliases_and_root_config {
            Imports, aliases, and root-alias config.
            Ideasets as a module's published surface.
        }
        attribute_grammar_breadth {
            Flags, negated flags, block values, nested and named lists.
            Arbitrary at-keys as a domain dialect.
        }
        completion_and_deprecation_analysers {
            Reqlan: Completion Status and Reqlan: Deprecation Impact —
            real shipped analysers nobody is showing.
        }
        cytoscape_graph_view {
            Status/tag filters, indirect-reference depth toggle, and Wildcard refs edge toggle
            (["../extension/module/ideas_summary/graphical_graph.rq".wildcard_refs_toggle]).
        }
        wildcard_path_idea_refs {
            Qualified path + idea-pattern references — `["../mod/**/*.rq".*_pane]` —
            fan out across files as `wildcard_reference` edges
            (["../indexer/indexer.rq".wildcard_reference_edges]); navigation opens a matches panel.
            See ["../language/imports.rq".wildcard_references],
            ["../extension/module/ideas_summary/graphical_graph.rq".wildcard_refs_toggle].
        }
        html_multipage_export {
            HTML multi-page export as an actual deliverable.
        }
    )
    @tags (
        features
        tier-2
    )
}

features_not_demonstrated {
    Deliberately not demonstrated — they do not exist yet.
    Typed relation kinds, hover cards, autoformatting,
    JSON/CSV export palette commands, PDF binary, vector-embedding search.
    Keyword-scored search must not be marketed as semantic search / embeddings.
}

// --- the eleven showcases ----------------------------------------------------

agent_context_showcase {
    Flagship. Context for the agent, not the repo.
    An agent answers a question about session expiry.
    Show the repo-dump cost, then MCP file_context returning six ideas and their
    edges, then the plan the agent writes.
    Absorbs former agentic-planning and feature-tracking pages.

    @domain ai-tooling
    @mechanism (
        mcp_tools
        token_discipline
    )
    @tier flagship
    @status done
    @tags (
        ai
        mcp
        planning
    )
}

interlock_showcase {
    Flagship. The interlock that must not fail.
    A safety requirement bound to ["./plc/interlock.stL#41-58"] by symbol and
    line range, to a vitest case by test name, with an rq-comment in the ST
    source pointing back.
    Domain: industrial control / IEC 61131.

    @domain industrial-control
    @mechanism (
        symbol_refs
        line_ranges
        test_anchors
        comment_links
    )
    @tier flagship
    @status done
    @tags (
        industrial
        safety
        sequencing
    )
}

broken_links_showcase {
    Flagship. Links that break loudly.
    Someone renames a file. Show the diagnostic, the quick-fix menu, and the
    rewritten refs. This is the argument against a wiki.
    Domain: refactor safety, any stack.

    @domain refactor-safety
    @mechanism (
        unresolved_ref_diagnostics
        code_actions
        file_mutation_hooks
    )
    @tier flagship
    @status done
    @tags (
        diagnostics
        refactor
    )
}

firmware_cloud_contract_showcase {
    Flagship. The contract between firmware and cloud.
    A 10 Hz sample rate and a 50 ms ingest deadline: one invariant, two
    codebases, neither of which can express it alone.
    Absorbs half of former glue-semantics and static-connection.

    @domain embedded-backend
    @mechanism (
        cross_stack_file_refs
        idea_as_connective_tissue
        inbound_reference_inlay_hints
    )
    @tier flagship
    @status done
    @tags (
        integration
        cross-stack
        embedded
    )
}

audit_trail_showcase {
    Depth. An audit trail you can export.
    Custom clause / evidence / verified_by attributes, then Completion Status
    showing the coverage gap, then HTML export as the auditor's deliverable.
    Domain: regulated software — IEC 62304 or SOC 2.
    Absorbs former compliance page.

    @domain regulated-software
    @mechanism (
        custom_attributes
        completion_status
        html_export
    )
    @tier depth
    @status done
    @tags (
        compliance
        audit
        export
    )
}

module_surface_showcase {
    Depth. A module's published surface.
    billing/interface.rq exports an ideaset; checkout.rq imports only that;
    reaching past the boundary is an unresolved-import error.
    Ideasets-as-public-API is undemonstrated today.
    Absorbs half of former glue-semantics and module-interface.

    @domain monorepo-architecture
    @mechanism (
        ideasets
        imports
        unresolved_import_diagnostics
    )
    @tier depth
    @status done
    @tags (
        modularity
        imports
        ideasets
    )
}

test_proves_showcase {
    Depth. What this test actually proves.
    Keep the intent of the former test-explanation page; upgrade it with a real
