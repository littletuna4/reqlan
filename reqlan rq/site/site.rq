claim_cycle {
    Show one claim at a time and cycle in order.
    Pause on hover or focus. Tracks jump to a claim.
    The active claim sits in the vertical centre of a slot sized for the longest claim, so shorter lines do not jump to the top.
    @status done
    @implementation (
        ["../../site/src/components/ElevatorPitch.tsx"]
        ["../../site/src/components/ElevatorPitch.module.css"]
    )
}

claim_progress {
    A track per claim shows hold-time state: past tracks are full, the current track fills left to right, later tracks stay empty.
    Pause holds the fill. The fill and the cycle share one clock so they do not drift.
    @status done
    @implementation (
        ["../../site/src/components/ElevatorPitch.tsx"]
        ["../../site/src/components/ElevatorPitch.module.css"]
    )
}

claim_reduced_motion {
    When the visitor prefers reduced motion, show the full claim list with no cycle and no progress animation.
    @status done
    @implementation (
        ["../../site/src/components/ElevatorPitch.tsx"]
        ["../../site/src/components/ElevatorPitch.module.css"]
    )
}

