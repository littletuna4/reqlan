from "../ontology.rq" import extension, base
from "../extension/module/index.rq" import application_memory
import "../core_analysis/html_export.rq" as html_export
from "../bases/base.rq" import create_base_onboarding


cli_package {
    `packages/cli` (`@reqlan/cli`) is the Clipanion CLI published to npm as the `reqlan` (and `rq`) binary.
    Headless commands go through the core analytical engine (`@reqlan/analytical/core` / `reqlan-napi`), not Langium.
    Entry: ["../../packages/cli/src/main.ts"] via ["../../packages/cli/bin/cli.js"] ([windows_esm_entry]).
    Analysis commands reuse [application_memory] (`<base>/.reqlan`) and the analytical ["../indexer/indexer.rq".index] so the CLI shares the ideas index with the extension and MCP.
    @tests (
        ["../../packages/cli/test/runtime-engine.test.ts:CLI runtime opens AnalysisApi through the core engine"]
        ["../../packages/cli/test/runtime-engine.test.ts:CLI commands do not statically import Langium or @reqlan/language"]
        ["../../packages/cli/test/runtime-engine.test.ts:search does not load the Langium language module"]
        ["../../packages/analytical/test/native-headless-entry.test.ts:native module graph does not value-import Langium or @reqlan/language"]
    )
}

architecture {
    The cli should be a thin wrapper around `@reqlan/analytical/core` (Rust engine).
    `search` / `analyse` / `export` / `init` / `parse` must not load `@reqlan/language`.
    `barrel` may dynamically import the Langium barrel helper because page splits stay JS text edits
    (["../core_analysis/rust_port.rq".native_bridge]).
    @status done
}

windows_esm_entry {
    Node's ESM loader on Windows requires `file://` URLs for absolute dynamic `import()`.
    A native path such as `C:\...\out\main.js` is read as protocol `c:` and crashes every command, including `init`.
    `bin/cli.js` converts the compiled entry with `fsPathToEsmSpecifier` (`pathToFileURL`).
    The MCP stdio entry ["../../packages/mcp/bin/mcp.js"] uses the same `pathToFileURL` conversion.
    @status done
    @implementation (
        ["../../packages/cli/bin/cli.js"]
        ["../../packages/cli/src/esm-path.ts"]
        ["../../packages/mcp/bin/mcp.js"]
    )
    @tests (
        ["../../packages/cli/test/windows-esm-entry.test.ts:does not treat a Windows drive letter as a URL scheme"]
        ["../../packages/cli/test/windows-esm-entry.test.ts:CLI bin loads the compiled entry via an ESM file URL helper"]
        ["../../packages/cli/test/windows-esm-entry.test.ts:MCP bin converts the compiled entry with pathToFileURL"]
    )
}

commands {
    Minimal commands:
    - `parse <file>` — parse one `.rq` file via the core engine `parseReqlanSource` (Rust `reqlan-parse`); print diagnostics or an AST summary (`--json` for machine output).
    - `analyse` / `analyze` — file (`--file`), idea (`--idea`), workspace completion (default), or broken references (`--broken-refs`) via `AnalysisApi`.
      `--glob` limits `--broken-refs` to a path subset of the base.
      `--include-comments` adds unresolved ["../language/syntax.rq".comment_reference] sites (["../core_analysis/core.rq".test_references]).
    - `search <query>` — semantic search via `AnalysisApi.searchRequirements`.
      Repeatable `--context <path|path#idea|name>` biases ranking by graph hop distance
      (["../core_analysis/search.rq".contextual_search]).
    - `export` / `export html` — multi-file HTML site via `NativeAnalysisApi.exportHtml` ([html_export.html_export]).
      `--exclude-secret` omits `*.secret.rq`.
      `--exclude-ignored` omits paths matched by `.reqlan/.rqignore`.
      `--url-base` mounts root-relative hrefs per [html_export.html_export_url_base].
      `--header-href` / `--header-label` set the topbar home link per [html_export.html_export_header_link].
    - `init [directory]` — create a new [base] marker (`.reqlan`) at the given path or cwd ([init]).
    - `barrel <file>` — split a large `.rq` page into one file per idea and a container import page (["../extension/features-commands.rq".barrel_page]).
}

watch {
    The cli should be able to watch a base and maintain the index as files change.
    @todo
}

init {
    The cli should be able to initialise a new [base].
    Creates `<path>/.reqlan/` (empty directory is a valid marker), matching [create_base_onboarding].
    Headless helper lives in `@reqlan/analytical` so CLI and extension share one create-base path.
    @status done
    @implementation (
        ["../../packages/analytical/src/core/create-base.ts"]
        ["../../packages/cli/src/commands/init.ts"]
        ["../../packages/extension/src/analytical_submodule/index-store/index-service.ts"]
    )
    @tests (
        ["../../packages/analytical/test/create-base.test.ts:creates .reqlan marker and reports created"]
        ["../../packages/analytical/test/create-base.test.ts:is idempotent when marker already exists"]
        ["../../packages/cli/test/windows-esm-entry.test.ts:CLI bin loads the compiled entry via an ESM file URL helper"]
    )
}

function_parity {
    CLI shares headless function definitions with MCP and other tools through `@reqlan/analytical` `AnalysisApi`, not VS Code host APIs from [extension].
    On-disk index storage follows [application_memory] (same `.reqlan` path as the extension); optional override via `REQLAN_INDEX_PATH`.
    @status done
}


