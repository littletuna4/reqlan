      "background": "brand-panel",
      "content": {
        "heading": "Wrong folder trap",
        "body": "Parent monorepo? Pass --cwd to the demo base.",
        "code": "npx reqlan --cwd reqlan-tutorials-demo search \"empty password\"",
        "code_lang": "bash",
        "code_label": "terminal"
      },
      "notes": "CLI and chat disagree → cwd or active base is usually wrong."
