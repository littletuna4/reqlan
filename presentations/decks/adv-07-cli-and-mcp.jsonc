        "asset": "chat-search",
        "code": "Reqlan: Install Cursor Skills",
        "code_label": "example"
      },
      "notes": "Skills mirror human chat commands with token discipline."
    },
    {
      "id": "parity",
      "transition": "fade",
      "background": "brand-panel",
      "content": {
        "heading": "CLI vs chat parity",
        "body": "Same query, same hit — if not, check cwd and active base.",
        "code": "npx reqlan search … / @reqlan /rq-search …",
        "code_lang": "txt",
        "code_label": "example"
      },
      "notes": "Two hosts, one analytical core."
    },
