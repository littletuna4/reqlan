{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build reqlan",
      "command": "pnpm run build",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Langium: Generate grammar and build the reqlan language",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "server-process"
      }
    },
    {
      "label": "Build extension for debugging",
      "command": "node packages/extension/scripts/build.mjs",
      "type": "shell",
      "problemMatcher": "$tsc",
      "detail": "Generate dependencies, stage the host native analytical engine, and rebuild extension-host, language-server, and webview output before F5"
    },
    {
      "label": "Dev: verify extension build output",
      "type": "shell",
      "command": "node -e \"const p=require('./packages/extension/package.json');const f=require('path').resolve('packages/extension',p.main);if(!require('fs').existsSync(f)){console.error('MISSING main entry: '+f);process.exit(1)}console.log('OK main: '+f+' | engines.vscode: '+p.engines.vscode)\"",
      "problemMatcher": [],
      "detail": "Fail fast if the extension's package.json 'main' file is missing after the build; prints engines.vscode so you can compare it with Cursor's VS Code version (Help > About)"
    },
    {
      "label": "Dev: build and verify extension",
      "dependsOrder": "sequence",
      // Build only (skip the verify step) by removing the second entry:
      "dependsOn": [
        "Build extension for debugging",
        "Dev: verify extension build output"
      ],
      "problemMatcher": [],
      "detail": "Used as the preLaunchTask for F5 launches"
    },
    {
      "label": "Dev: reset dev profile",
      "type": "shell",
      "command": "rm -rf \"${workspaceFolder}/.vscode/dev-user-data\"",
      // Also wipe the VSIX-installed copy before reinstalling:
      // "command": "rm -rf \"${workspaceFolder}/.vscode/dev-user-data\" \"${workspaceFolder}/.vscode/reqlan-dev.vsix\"",
      "problemMatcher": [],
      "detail": "Delete the isolated dev profile; a stale or corrupt profile is a common cause of flaky-then-dead extension host launches"
    },
    {
      "label": "Dev: package and install into Cursor",
      "type": "shell",
      "dependsOn": ["Dev: build and verify extension"],
      "command": "cd packages/extension && npx vsce package --no-dependencies -o \"${workspaceFolder}/.vscode/reqlan-dev.vsix\" && cursor --install-extension \"${workspaceFolder}/.vscode/reqlan-dev.vsix\" --force",
      "problemMatcher": [],
      "detail": "Fallback when the extensionHost launch is dropped by Cursor/WSL: install the built extension as a VSIX, then reload the Cursor window and use the 'Attach to Language Server' launch config"
    },
    {
      "label": "Dev: run extension in VS Code (CLI)",
      "type": "shell",
      "dependsOn": ["Dev: build and verify extension"],
      // Uses the 'code' CLI explicitly, so it never opens Cursor. Check with: code --version
      // (stock VS Code prints a commit hash; if it is not VS Code, use the full path instead).
      "command": "code --new-window --extensionDevelopmentPath=\"${workspaceFolder}/packages/extension\" --inspect-extensions=5870",
      // Add a folder to open: "... --inspect-extensions=5870 \"${workspaceFolder}/../process-twin\"",
      "problemMatcher": [],
      "detail": "Launch stock VS Code with the extension under development (no Cursor). Attach with the 'Attach to Extension Host (VS Code CLI)' launch config."
    },
    {
      "label": "Watch reqlan",
      "command": "pnpm run watch",
      "type": "shell",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "detail": "Langium, TypeScript, and extension bundler watch for grammar and language server changes",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "eye"
      }
    },
    {
      "label": "Run Extension (new window)",
      // "command": "cursor \"${workspaceFolder}/reqlan-debug.code-workspace\"",
      "command": "cursor \"${workspaceFolder}/../process-twin\"",
      // Same, but in stock VS Code:
      // "command": "code \"${workspaceFolder}/../process-twin\"",
      "type": "shell",
      "detail": "Open the debug workspace in Cursor. For extension development with an isolated profile, use the 'Run Extension' launch config (F5) instead — the Cursor WSL CLI ignores --user-data-dir, --profile-temp, and --extensionDevelopmentPath.",
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "vscode"
      }
    }
  ]
}
